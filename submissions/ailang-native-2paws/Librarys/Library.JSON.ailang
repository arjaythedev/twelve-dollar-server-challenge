// =============================================================================
// OBJECT GETTERS - Lookup key, unwrap tagged value
// =============================================================================
Function.JSON.GetString {
    Input: obj: Address
    Input: key: Address
    Output: Address
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        tagged = SHash.Lookup(obj, key)
        IfCondition EqualTo(tagged, Arrays.NULL) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSON.AsString(tagged))
    }
}

Function.JSON.GetNumber {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        tagged = SHash.Lookup(obj, key)
        IfCondition EqualTo(tagged, Arrays.NULL) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSON.AsNumber(tagged))
    }
}

Function.JSON.GetBool {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        tagged = SHash.Lookup(obj, key)
        IfCondition EqualTo(tagged, Arrays.NULL) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSON.AsBool(tagged))
    }
}

Function.JSON.GetObject {
    Input: obj: Address
    Input: key: Address
    Output: Address
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        tagged = SHash.Lookup(obj, key)
        IfCondition EqualTo(tagged, Arrays.NULL) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSON.AsObject(tagged))
