# Profiling: the submitted Caddyfile (worker mode) + Excimer (see profile/excimer.php).
{
	auto_https off
	admin off

	frankenphp {
		max_threads 8
		php_ini auto_prepend_file /app/local-bench/profile/excimer.php
		worker {
			file ./public/index.php
		}
	}
}

http://:{$PORT} {
	bind {$HOST}
	root ./public
	rewrite * /index.php
	php
}
