LibraryImport.Arena
LibraryImport.Env
LibraryImport.JSON
LibraryImport.Crypto
LibraryImport.HTTP1
LibraryImport.HTTP1Front
LibraryImport.SQLite
LibraryImport.VDSO

FixedPool.FeedSt {
    "out": Initialize=0, CanChange=True
    "cap": Initialize=65536, CanChange=True
    "len": Initialize=0, CanChange=True
    "ts": Initialize=0, CanChange=True
    "iso": Initialize=0, CanChange=True
    "rest": Initialize=0, CanChange=True
    "secret": Initialize=0, CanChange=True
    "start": Initialize=0, CanChange=True
    "ok": Initialize=0, CanChange=True
    "uname": Initialize=0, CanChange=True
    // The new post's trimmed body, copied out of the scratch arena (at most 500 bytes)
    "body": Initialize=0, CanChange=True
    // A feed post's fixed JSON pieces as little-endian words, stored 8 bytes at a time
    // (the bytes past each piece are overwritten by what follows). Set in Feed.Init.
    "k_id": Initialize=0, CanChange=True
    "k_body0": Initialize=0, CanChange=True
    "k_body1": Initialize=0, CanChange=True
    "k_cr0": Initialize=0, CanChange=True
    "k_cr1": Initialize=0, CanChange=True
    "k_au0": Initialize=0, CanChange=True
    "k_au1": Initialize=0, CanChange=True
    "k_lc0": Initialize=0, CanChange=True
    "k_lc1": Initialize=0, CanChange=True
    // x / 10 = (x * recip10) >> 35 for 0 <= x < 2^32. Kept in a variable: the compiler
    // mis-encodes Multiply by an immediate above 2^31.
    "recip10": Initialize=0, CanChange=True
}

Function.Feed.Init {
    Body: {
        FeedSt.k_id = 63919387910779
        FeedSt.k_body0 = 4189044075680375340
        FeedSt.k_body1 = 34
        FeedSt.k_cr0 = 8386095523104435234
        FeedSt.k_cr1 = 2466321629183960165
        FeedSt.k_au0 = 8027794383277534242
        FeedSt.k_au1 = 574235250
        FeedSt.k_lc0 = 6874018506780847138
        FeedSt.k_lc1 = 16363432113958755
        FeedSt.recip10 = 3435973837
    }
}

Function.Feed.NowUnix {
    Output: Integer
    Body: {
        VDSO.ClockGettime(0, FeedSt.ts)
        ReturnValue(RDMEM_64(FeedSt.ts))
    }
}

Function.Feed.PutDigits {
    Input: buf: Address
    Input: off: Integer
    Input: width: Integer
    Input: v: Integer
    Body: {
        x = v
        i = Subtract(width, 1)
        WhileLoop GreaterEqual(i, 0) {
            d = Modulo(x, 10)
            WRMEM_8(buf, Add(off, i), Add(48, d))
            x = Divide(x, 10)
            i = Subtract(i, 1)
        }
    }
}

Function.Feed.NowISO {
    Output: Address
    Body: {
        sec = Feed.NowUnix()
        ns = RDMEM_64(Add(FeedSt.ts, 8))
        ms = Divide(ns, 1000000)
        days = Divide(sec, 86400)
        sod = Subtract(sec, Multiply(days, 86400))
        hh = Divide(sod, 3600)
        rem = Subtract(sod, Multiply(hh, 3600))
        mm = Divide(rem, 60)
        ss = Subtract(rem, Multiply(mm, 60))
        z = Add(days, 719468)
        era = Divide(z, 146097)
        doe = Subtract(z, Multiply(era, 146097))
        a = Divide(doe, 1460)
        b = Divide(doe, 36524)
        c = Divide(doe, 146096)
        yoe = Divide(Subtract(Add(doe, b), Add(a, c)), 365)
        y = Add(yoe, Multiply(era, 400))
        y4 = Divide(yoe, 4)
        y100 = Divide(yoe, 100)
        doy = Subtract(doe, Subtract(Add(Multiply(365, yoe), y4), y100))
        mp = Divide(Add(Multiply(5, doy), 2), 153)
        d = Add(Subtract(doy, Divide(Add(Multiply(153, mp), 2), 5)), 1)
        m = 0
        IfCondition LessThan(mp, 10) ThenBlock: {
            m = Add(mp, 3)
        }
        IfCondition GreaterEqual(mp, 10) ThenBlock: {
            m = Subtract(mp, 9)
        }
        IfCondition LessEqual(m, 2) ThenBlock: {
            y = Add(y, 1)
        }
        buf = FeedSt.iso
        Feed.PutDigits(buf, 0, 4, y)
        WRMEM_8(buf, 4, 45)
        Feed.PutDigits(buf, 5, 2, m)
        WRMEM_8(buf, 7, 45)
        Feed.PutDigits(buf, 8, 2, d)
        WRMEM_8(buf, 10, 84)
        Feed.PutDigits(buf, 11, 2, hh)
        WRMEM_8(buf, 13, 58)
        Feed.PutDigits(buf, 14, 2, mm)
        WRMEM_8(buf, 16, 58)
        Feed.PutDigits(buf, 17, 2, ss)
        WRMEM_8(buf, 19, 46)
        Feed.PutDigits(buf, 20, 3, ms)
        WRMEM_8(buf, 23, 90)
        WRMEM_8(buf, 24, 0)
        ReturnValue(buf)
    }
}

Function.Feed.Reset {
    Body: {
        FeedSt.len = 0
    }
}

Function.Feed.Put {
    Input: src: Address
    Input: n: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        ol = FeedSt.len
        IfCondition GreaterThan(Add(ol, n), FeedSt.cap) ThenBlock: {
            n = Subtract(FeedSt.cap, ol)
        }
        IfCondition GreaterThan(n, 0) ThenBlock: {
            MemoryCopy(Add(FeedSt.out, ol), src, n)
            FeedSt.len = Add(ol, n)
        }
    }
}

Function.Feed.PutZ {
    Input: s: Address
    Body: {
        n = StringLength(s)
        Feed.Put(s, n)
    }
}

Function.Feed.PutInt {
    Input: v: Integer
    Body: {
        ol = FeedSt.len
        cap = FeedSt.cap
        out = FeedSt.out
        IfCondition EqualTo(v, 0) ThenBlock: {
            IfCondition LessThan(ol, cap) ThenBlock: {
                WRMEM_8(out, ol, 48)
                FeedSt.len = Add(ol, 1)
            }
            ReturnValue(0)
        }
        x = v
        IfCondition LessThan(x, 0) ThenBlock: {
            IfCondition LessThan(ol, cap) ThenBlock: {
                WRMEM_8(out, ol, 45)
                ol = Add(ol, 1)
            }
            x = Subtract(0, x)
        }
        n = 1
        IfCondition GreaterEqual(x, 10) ThenBlock: {
            n = 2
            IfCondition GreaterEqual(x, 100) ThenBlock: {
                n = 3
                IfCondition GreaterEqual(x, 1000) ThenBlock: {
                    n = 4
                    IfCondition GreaterEqual(x, 10000) ThenBlock: {
                        n = 5
                        IfCondition GreaterEqual(x, 100000) ThenBlock: {
                            n = 6
                            IfCondition GreaterEqual(x, 1000000) ThenBlock: {
                                n = 7
                                t = x
                                WhileLoop GreaterEqual(t, 10000000) {
                                    n = Add(n, 1)
                                    t = Divide(t, 10)
                                }
                            }
                        }
                    }
                }
            }
        }
        IfCondition GreaterThan(Add(ol, n), cap) ThenBlock: {
            n = Subtract(cap, ol)
        }
        IfCondition LessEqual(n, 0) ThenBlock: {
            FeedSt.len = ol
            ReturnValue(0)
        }
        i = Subtract(n, 1)
        IfCondition LessThan(x, 4294967296) ThenBlock: {
            r = FeedSt.recip10
            WhileLoop GreaterEqual(i, 0) {
                q = RightShift(Multiply(x, r), 35)
                WRMEM_8(out, Add(ol, i), Add(48, Subtract(x, Multiply(q, 10))))
                x = q
                i = Subtract(i, 1)
            }
            FeedSt.len = Add(ol, n)
            ReturnValue(0)
        }
        WhileLoop GreaterEqual(i, 0) {
            d = Modulo(x, 10)
            WRMEM_8(out, Add(ol, i), Add(48, d))
            x = Divide(x, 10)
            i = Subtract(i, 1)
        }
        FeedSt.len = Add(ol, n)
    }
}

Function.Feed.PutByte {
    Input: ch: Integer
    Body: {
        ol = FeedSt.len
        IfCondition LessThan(ol, FeedSt.cap) ThenBlock: {
            WRMEM_8(FeedSt.out, ol, ch)
            FeedSt.len = Add(ol, 1)
        }
    }
}

Function.Feed.PutEscByte {
    Input: ch: Integer
    Body: {
        IfCondition EqualTo(ch, 34) ThenBlock: {
            Feed.PutByte(92)
            Feed.PutByte(34)
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 92) ThenBlock: {
            Feed.PutByte(92)
            Feed.PutByte(92)
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 10) ThenBlock: {
            Feed.PutByte(92)
            Feed.PutByte(110)
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 13) ThenBlock: {
            Feed.PutByte(92)
            Feed.PutByte(114)
            ReturnValue(0)
        }
        IfCondition EqualTo(ch, 9) ThenBlock: {
            Feed.PutByte(92)
            Feed.PutByte(116)
            ReturnValue(0)
        }
        IfCondition LessThan(ch, 32) ThenBlock: {
            Feed.PutByte(92)
            Feed.PutByte(117)
            Feed.PutByte(48)
            Feed.PutByte(48)
            hi = Divide(ch, 16)
            lo = Modulo(ch, 16)
            hc = Add(48, hi)
            IfCondition GreaterThan(hi, 9) ThenBlock: { hc = Add(87, hi) }
            lc = Add(48, lo)
            IfCondition GreaterThan(lo, 9) ThenBlock: { lc = Add(87, lo) }
            Feed.PutByte(hc)
            Feed.PutByte(lc)
            ReturnValue(0)
        }
        Feed.PutByte(ch)
    }
}

// Most text needs no escaping: test 8 bytes at a time for a control byte, '"' or
// '\\' (bytes >= 0x80, UTF-8, never match) and copy the whole run when none is found
Function.Feed.PutEscN {
    Input: p: Address
    Input: n: Integer
    Body: {
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        ol = FeedSt.len
        // One pass: each 8-byte word is tested for '"', '\' and bytes below
        // 0x20, and a clean word is stored straight to the output. The first
        // special byte switches to Feed.PutEscByte from there. The output has
        // 64 bytes of slack past cap, so the last word store may run past n.
        IfCondition GreaterThan(Add(ol, n), FeedSt.cap) ThenBlock: {
            Feed.PutEscSlow(p, 0, n)
            ReturnValue(0)
        }
        out = Add(FeedSt.out, ol)
        ones = 72340172838076673
        hi = Multiply(ones, 128)
        c20 = Multiply(ones, 32)
        q = Multiply(ones, 34)
        bs = Multiply(ones, 92)
        i = 0
        WhileLoop LessEqual(Add(i, 8), n) {
            w = RDMEM_64(Add(p, i))
            nw = BitwiseXor(w, -1)
            t = Subtract(w, c20)
            t = BitwiseAnd(t, nw)
            wq = BitwiseXor(w, q)
            u = Subtract(wq, ones)
            v = BitwiseXor(wq, -1)
            u = BitwiseAnd(u, v)
            t = BitwiseOr(t, u)
            wb = BitwiseXor(w, bs)
            u = Subtract(wb, ones)
            v = BitwiseXor(wb, -1)
            u = BitwiseAnd(u, v)
            t = BitwiseOr(t, u)
            t = BitwiseAnd(t, hi)
            IfCondition NotEqual(t, 0) ThenBlock: {
                FeedSt.len = Add(ol, i)
                Feed.PutEscSlow(p, i, n)
                ReturnValue(0)
            }
            WRMEM_64(Add(out, i), w)
            i = Add(i, 8)
        }
        WhileLoop LessThan(i, n) {
            ch = RDMEM_8(p, i)
            IfCondition Or(Or(EqualTo(ch, 34), EqualTo(ch, 92)), LessThan(ch, 32)) ThenBlock: {
                FeedSt.len = Add(ol, i)
                Feed.PutEscSlow(p, i, n)
                ReturnValue(0)
            }
            WRMEM_8(out, i, ch)
            i = Add(i, 1)
        }
        FeedSt.len = Add(ol, n)
    }
}

// Bytes [from, n) of p through the escaping writer.
Function.Feed.PutEscSlow {
    Input: p: Address
    Input: from: Integer
    Input: n: Integer
    Body: {
        i2 = from
        WhileLoop LessThan(i2, n) {
            Feed.PutEscByte(RDMEM_8(p, i2))
            i2 = Add(i2, 1)
        }
    }
}

// One feed entry. The output buffer has 64 bytes of slack past cap, and a feed is far
// below cap, so the 8-byte stores of the fixed pieces never leave it.
Function.Feed.PutPost {
    Body: {
        out = FeedSt.out
        ol = FeedSt.len
        WRMEM_64(Add(out, ol), FeedSt.k_id)
        FeedSt.len = Add(ol, 6)
        Feed.PutInt(SQLitePost.id)
        ol = FeedSt.len
        p = Add(out, ol)
        WRMEM_64(p, FeedSt.k_body0)
        WRMEM_64(Add(p, 8), FeedSt.k_body1)
        FeedSt.len = Add(ol, 9)
        Feed.PutEscN(SQLitePost.body, SQLitePost.body_n)
        ol = FeedSt.len
        p = Add(out, ol)
        WRMEM_64(p, FeedSt.k_cr0)
        WRMEM_64(Add(p, 8), FeedSt.k_cr1)
        ol = Add(ol, 16)
        cp = SQLitePost.created
        cn = SQLitePost.created_n
        IfCondition And(NotEqual(cp, 0), GreaterThan(cn, 0)) ThenBlock: {
            MemoryCopy(Add(out, ol), cp, cn)
            ol = Add(ol, cn)
        }
        p = Add(out, ol)
        WRMEM_64(p, FeedSt.k_au0)
        WRMEM_64(Add(p, 8), FeedSt.k_au1)
        ol = Add(ol, 12)
        ap = SQLitePost.author
        an = SQLitePost.author_n
        IfCondition And(NotEqual(ap, 0), GreaterThan(an, 0)) ThenBlock: {
            MemoryCopy(Add(out, ol), ap, an)
            ol = Add(ol, an)
        }
        p = Add(out, ol)
        WRMEM_64(p, FeedSt.k_lc0)
        WRMEM_64(Add(p, 8), FeedSt.k_lc1)
        FeedSt.len = Add(ol, 15)
        Feed.PutInt(SQLitePost.likes)
        ol = FeedSt.len
        WRMEM_8(out, ol, 125)
        FeedSt.len = Add(ol, 1)
    }
}

Function.Feed.Reply {
    Input: conn: Address
    Input: status: Integer
    Body: {
        HTTP1.Reply(conn, status, FeedSt.out, FeedSt.len)
    }
}

Function.Feed.Err {
    Input: conn: Address
    Input: status: Integer
    Input: msg: Address
    Body: {
        Feed.Reset()
        Feed.PutZ("{\"error\":\"")
        Feed.PutZ(msg)
        Feed.PutZ("\"}")
        Feed.Reply(conn, status)
    }
}

Function.Feed.Starts {
    Input: s: Address
    Input: prefix: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            pc = RDMEM_8(prefix, i)
            IfCondition EqualTo(pc, 0) ThenBlock: { ReturnValue(1) }
            sc = RDMEM_8(s, i)
            IfCondition NotEqual(sc, pc) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Feed.ParseId {
    Input: p: Address
    Output: Integer
    Body: {
        FeedSt.rest = p
        c0 = RDMEM_8(p, 0)
        IfCondition LessThan(c0, 48) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(c0, 57) ThenBlock: { ReturnValue(0) }
        v = 0
        i = 0
        WhileLoop 1 {
            ch = RDMEM_8(p, i)
            IfCondition LessThan(ch, 48) ThenBlock: { BreakLoop }
            IfCondition GreaterThan(ch, 57) ThenBlock: { BreakLoop }
            v = Add(Multiply(v, 10), Subtract(ch, 48))
            i = Add(i, 1)
        }
        IfCondition EqualTo(i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        FeedSt.rest = Add(p, i)
        ReturnValue(v)
    }
}

Function.Feed.BearerOk {
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(b, 0), 66) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(b, 1), 101) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(b, 2), 97) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(b, 3), 114) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(b, 4), 101) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(b, 5), 114) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(b, 6), 32) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(RDMEM_8(b, 7), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Feed.Auth {
    Input: conn: Address
    Output: Integer
    Body: {
        b = HTTP1.Bearer(conn)
        okb = Feed.BearerOk(b)
        IfCondition EqualTo(okb, 0) ThenBlock: { ReturnValue(0) }
        tok = Add(b, 7)
        now = Feed.NowUnix()
        // Every token is verified in full. Its decode, HMAC and JSON buffers
        // come from the scratch arena and are dropped together afterwards;
        // the username is copied out first.
        Arena_ScratchBegin()
        rc = Crypto.JWT_HS256(tok, FeedSt.secret, now)
        IfCondition EqualTo(rc, 1) ThenBlock: {
            nm = JWTOut.name
            nl = StringLength(nm)
            IfCondition GreaterThan(nl, 255) ThenBlock: { nl = 255 }
            MemoryCopy(FeedSt.uname, nm, nl)
            WRMEM_8(FeedSt.uname, nl, 0)
            JWTOut.name = FeedSt.uname
        }
        Arena_ScratchEnd()
        IfCondition EqualTo(rc, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(rc, 2) ThenBlock: { ReturnValue(-2) }
        ReturnValue(-1)
    }
}

Function.Feed.AuthOrErr {
    Input: conn: Address
    Output: Integer
    Body: {
        a = Feed.Auth(conn)
        IfCondition EqualTo(a, 0) ThenBlock: {
            Feed.Err(conn, 401, "missing bearer token")
            ReturnValue(0)
        }
        IfCondition EqualTo(a, -1) ThenBlock: {
            Feed.Err(conn, 401, "invalid or expired token")
            ReturnValue(0)
        }
        IfCondition EqualTo(a, -2) ThenBlock: {
            Feed.Err(conn, 401, "invalid token payload")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.Feed.TrimCopy {
    Input: s: Address
    Output: Address
    Body: {
        i = 0
        WhileLoop 1 {
            ch = RDMEM_8(s, i)
            sp = 0
            IfCondition EqualTo(ch, 32) ThenBlock: { sp = 1 }
            IfCondition EqualTo(ch, 9) ThenBlock: { sp = 1 }
            IfCondition EqualTo(ch, 10) ThenBlock: { sp = 1 }
            IfCondition EqualTo(ch, 13) ThenBlock: { sp = 1 }
            IfCondition EqualTo(sp, 0) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        n = StringLength(s)
        e = n
        WhileLoop GreaterThan(e, i) {
            ch = RDMEM_8(s, Subtract(e, 1))
            sp = 0
            IfCondition EqualTo(ch, 32) ThenBlock: { sp = 1 }
            IfCondition EqualTo(ch, 9) ThenBlock: { sp = 1 }
            IfCondition EqualTo(ch, 10) ThenBlock: { sp = 1 }
            IfCondition EqualTo(ch, 13) ThenBlock: { sp = 1 }
            IfCondition EqualTo(sp, 0) ThenBlock: { BreakLoop }
            e = Subtract(e, 1)
        }
        ln = Subtract(e, i)
        out = Allocate(Add(ln, 1))
        IfCondition GreaterThan(ln, 0) ThenBlock: {
            MemoryCopy(out, Add(s, i), ln)
        }
        WRMEM_8(out, ln, 0)
        ReturnValue(out)
    }
}

Function.Feed.Health {
    Input: conn: Address
    Body: {
        Feed.Reset()
        dbok = SQLite.Select1()
        now = Feed.NowUnix()
        up = Subtract(now, FeedSt.start)
        IfCondition LessThan(up, 0) ThenBlock: { up = 0 }
        IfCondition EqualTo(dbok, 1) ThenBlock: {
            Feed.Put("{\"status\":\"ok\",\"db\":\"ok\",\"uptime_s\":", 36)
            Feed.PutInt(up)
            Feed.Put("}", 1)
            Feed.Reply(conn, 200)
        }
        IfCondition NotEqual(dbok, 1) ThenBlock: {
            Feed.Put("{\"status\":\"degraded\",\"db\":\"unreachable\",\"error\":\"database not open\"}", 68)
            Feed.Reply(conn, 503)
        }
    }
}

Function.Feed.DoFeed {
    Input: conn: Address
    Body: {
        n = SQLite.Feed20()
        FeedSt.len = 0
        MemoryCopy(FeedSt.out, "{\"posts\":[", 10)
        FeedSt.len = 10
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition GreaterThan(i, 0) ThenBlock: {
                ol = FeedSt.len
                WRMEM_8(FeedSt.out, ol, 44)
                FeedSt.len = Add(ol, 1)
            }
            SQLite.FeedLoad(i)
            Feed.PutPost()
            i = Add(i, 1)
        }
        ol2 = FeedSt.len
        dst = Add(FeedSt.out, ol2)
        FeedSt.len = Add(ol2, 2)
        MemoryCopy(dst, "]}", 2)
        Feed.Reply(conn, 200)
    }
}

Function.Feed.DoGetPost {
    Input: conn: Address
    Input: path: Address
    Body: {
        rest = Add(path, 7)
        id = Feed.ParseId(rest)
        endc = RDMEM_8(FeedSt.rest, 0)
        IfCondition EqualTo(id, 0) ThenBlock: {
            Feed.Err(conn, 400, "invalid post id")
            ReturnValue(0)
        }
        IfCondition NotEqual(endc, 0) ThenBlock: {
            Feed.Err(conn, 400, "invalid post id")
            ReturnValue(0)
        }
        gp = SQLite.GetPost(id)
        IfCondition EqualTo(gp, 0) ThenBlock: {
            Feed.Err(conn, 404, "post not found")
            ReturnValue(0)
        }
        FeedSt.len = 0
        MemoryCopy(FeedSt.out, "{\"post\":", 8)
        FeedSt.len = 8
        Feed.PutPost()
        ol = FeedSt.len
        WRMEM_8(FeedSt.out, ol, 125)
        FeedSt.len = Add(ol, 1)
        Feed.Reply(conn, 200)
    }
}

Function.Feed.JsonObjectOk {
    Input: s: Address
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            ch = RDMEM_8(s, i)
            ws = 0
            IfCondition EqualTo(ch, 32) ThenBlock: { ws = 1 }
            IfCondition EqualTo(ch, 9) ThenBlock: { ws = 1 }
            IfCondition EqualTo(ch, 10) ThenBlock: { ws = 1 }
            IfCondition EqualTo(ch, 13) ThenBlock: { ws = 1 }
            IfCondition EqualTo(ws, 0) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(i, n) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(s, i), 123) ThenBlock: { ReturnValue(0) }
        depth = 1
        in_str = 0
        esc = 0
        i = Add(i, 1)
        WhileLoop LessThan(i, n) {
            ch = RDMEM_8(s, i)
            IfCondition EqualTo(in_str, 1) ThenBlock: {
                IfCondition EqualTo(esc, 1) ThenBlock: {
                    esc = 0
                }
                ElseBlock: {
                    IfCondition EqualTo(ch, 92) ThenBlock: { esc = 1 }
                    IfCondition EqualTo(ch, 34) ThenBlock: { in_str = 0 }
                }
            }
            ElseBlock: {
                IfCondition EqualTo(ch, 34) ThenBlock: { in_str = 1 }
                IfCondition EqualTo(ch, 123) ThenBlock: { depth = Add(depth, 1) }
                IfCondition EqualTo(ch, 91) ThenBlock: { depth = Add(depth, 1) }
                IfCondition EqualTo(ch, 93) ThenBlock: { depth = Subtract(depth, 1) }
                IfCondition EqualTo(ch, 125) ThenBlock: {
                    depth = Subtract(depth, 1)
                    IfCondition EqualTo(depth, 0) ThenBlock: {
                        j = Add(i, 1)
                        WhileLoop LessThan(j, n) {
                            c2 = RDMEM_8(s, j)
                            ws2 = 0
                            IfCondition EqualTo(c2, 32) ThenBlock: { ws2 = 1 }
                            IfCondition EqualTo(c2, 9) ThenBlock: { ws2 = 1 }
                            IfCondition EqualTo(c2, 10) ThenBlock: { ws2 = 1 }
                            IfCondition EqualTo(c2, 13) ThenBlock: { ws2 = 1 }
                            IfCondition EqualTo(ws2, 0) ThenBlock: { ReturnValue(0) }
                            j = Add(j, 1)
                        }
                        ReturnValue(1)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Validate the POST /posts body and copy its trimmed text to FeedSt.body. Returns 0, or
// 1 malformed JSON, 2 body missing or empty, 3 body too long. Run inside a scratch arena.
Function.Feed.ParseBody {
    Input: conn: Address
    Output: Integer
    Body: {
        raw = HTTP1.Body(conn)
        n = HTTP1.BodyLen(conn)
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(1)
        }
        copy = Allocate(Add(n, 1))
        MemoryCopy(copy, raw, n)
        WRMEM_8(copy, n, 0)
        jok = Feed.JsonObjectOk(copy, n)
        IfCondition EqualTo(jok, 0) ThenBlock: {
            ReturnValue(1)
        }
        tag = ParseJSON(copy)
        IfCondition EqualTo(tag, 0) ThenBlock: {
            ReturnValue(1)
        }
        obj = JSON.AsObject(tag)
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(1)
        }
        ty = JSON.GetType(obj, "body")
        IfCondition NotEqual(ty, 1) ThenBlock: {
            ReturnValue(2)
        }
        body = JSON.GetString(obj, "body")
        IfCondition EqualTo(body, 0) ThenBlock: {
            ReturnValue(2)
        }
        trimmed = Feed.TrimCopy(body)
        tlen = StringLength(trimmed)
        IfCondition EqualTo(tlen, 0) ThenBlock: {
            ReturnValue(2)
        }
        IfCondition GreaterThan(tlen, 500) ThenBlock: {
            ReturnValue(3)
        }
        MemoryCopy(FeedSt.body, trimmed, tlen)
        WRMEM_8(FeedSt.body, tlen, 0)
        ReturnValue(0)
    }
}

Function.Feed.DoCreate {
    Input: conn: Address
    Body: {
        aok = Feed.AuthOrErr(conn)
        IfCondition EqualTo(aok, 0) ThenBlock: { ReturnValue(0) }
        // The body's copy, parse tree and trimmed text come from the scratch arena and
        // are dropped together; the body is copied out first.
        Arena_ScratchBegin()
        bad = Feed.ParseBody(conn)
        Arena_ScratchEnd()
        IfCondition EqualTo(bad, 1) ThenBlock: {
            Feed.Err(conn, 400, "malformed JSON body")
            ReturnValue(0)
        }
        IfCondition EqualTo(bad, 2) ThenBlock: {
            Feed.Err(conn, 400, "body is required")
            ReturnValue(0)
        }
        IfCondition EqualTo(bad, 3) ThenBlock: {
            Feed.Err(conn, 400, "body must be at most 500 characters")
            ReturnValue(0)
        }
        trimmed = FeedSt.body
        tlen = StringLength(trimmed)
        uid = Crypto.JWT_Uid()
        created = Feed.NowISO()
        nid = SQLite.InsertPost(uid, trimmed, created)
        IfCondition LessThan(nid, 1) ThenBlock: {
            Feed.Err(conn, 500, "internal server error")
            ReturnValue(0)
        }
        author = Crypto.JWT_Username()
        SQLitePost.id = nid
        SQLitePost.body = trimmed
        SQLitePost.body_n = tlen
        SQLitePost.created = created
        SQLitePost.created_n = StringLength(created)
        SQLitePost.author = author
        SQLitePost.author_n = StringLength(author)
        SQLitePost.likes = 0
        Feed.Reset()
        Feed.Put("{\"post\":", 8)
        Feed.PutPost()
        Feed.Put("}", 1)
        Feed.Reply(conn, 201)
        HTTP1.Defer(conn)
    }
}

Function.Feed.DoLike {
    Input: conn: Address
    Input: path: Address
    Body: {
        aok = Feed.AuthOrErr(conn)
        IfCondition EqualTo(aok, 0) ThenBlock: { ReturnValue(0) }
        pre = Feed.Starts(path, "/posts/")
        IfCondition EqualTo(pre, 0) ThenBlock: {
            Feed.Err(conn, 404, "not found")
            ReturnValue(0)
        }
        rest = Add(path, 7)
        id = Feed.ParseId(rest)
        likeok = Feed.Starts(FeedSt.rest, "/like")
        endc = RDMEM_8(FeedSt.rest, 5)
        IfCondition EqualTo(id, 0) ThenBlock: {
            Feed.Err(conn, 400, "invalid post id")
            ReturnValue(0)
        }
        IfCondition EqualTo(likeok, 0) ThenBlock: {
            Feed.Err(conn, 400, "invalid post id")
            ReturnValue(0)
        }
        IfCondition NotEqual(endc, 0) ThenBlock: {
            Feed.Err(conn, 400, "invalid post id")
            ReturnValue(0)
        }
        uid = Crypto.JWT_Uid()
        created = Feed.NowISO()
        rc = SQLite.LikePost(uid, id, created)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            Feed.Err(conn, 404, "post not found")
            ReturnValue(0)
        }
        Feed.Reset()
        Feed.Put("{\"liked\":true,\"already_liked\":", 30)
        IfCondition EqualTo(rc, 2) ThenBlock: {
            Feed.Put("true", 4)
        }
        IfCondition NotEqual(rc, 2) ThenBlock: {
            Feed.Put("false", 5)
        }
        Feed.Put(",\"post_id\":", 11)
        Feed.PutInt(id)
        Feed.Put("}", 1)
        st = 201
        IfCondition EqualTo(rc, 2) ThenBlock: { st = 200 }
        Feed.Reply(conn, st)
        IfCondition EqualTo(rc, 1) ThenBlock: {
            HTTP1.Defer(conn)
        }
    }
}

Function.Feed.CommitBatch {
    Input: unused: Address
    Body: {
        SQLite.Commit()
        HTTP1St.commit_seq = SQLiteIo.commit_seq
    }
}

Function.Feed.WaitDone {
    Input: seq: Integer
    Body: {
        SQLite.IoWait(seq)
    }
}

Function.FeedHandler {
    Input: conn: Address
    Body: {
        method = HTTP1.Method(conn)
        path = HTTP1.Path(conn)
        m0 = RDMEM_8(method, 0)
        IfCondition EqualTo(m0, 71) ThenBlock: {
            IfCondition NotEqual(RDMEM_8(method, 1), 69) ThenBlock: {
                Feed.Err(conn, 404, "not found")
                ReturnValue(0)
            }
            IfCondition NotEqual(RDMEM_8(method, 2), 84) ThenBlock: {
                Feed.Err(conn, 404, "not found")
                ReturnValue(0)
            }
            IfCondition NotEqual(RDMEM_8(method, 3), 0) ThenBlock: {
                Feed.Err(conn, 404, "not found")
                ReturnValue(0)
            }
            Arena_ScratchBegin()
            p0 = RDMEM_8(path, 0)
            p1 = RDMEM_8(path, 1)
            IfCondition EqualTo(p0, 47) ThenBlock: {
                IfCondition EqualTo(p1, 102) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(path, 2), 101) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(path, 3), 101) ThenBlock: {
                            IfCondition EqualTo(RDMEM_8(path, 4), 100) ThenBlock: {
                                IfCondition EqualTo(RDMEM_8(path, 5), 0) ThenBlock: {
                                    Feed.DoFeed(conn)
                                    Arena_ScratchEnd()
                                    ReturnValue(0)
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(p1, 104) ThenBlock: {
                    hcmp = StringCompare(path, "/health")
                    IfCondition EqualTo(hcmp, 0) ThenBlock: {
                        Feed.Health(conn)
                        Arena_ScratchEnd()
                        ReturnValue(0)
                    }
                }
                IfCondition EqualTo(p1, 112) ThenBlock: {
                    pre = Feed.Starts(path, "/posts/")
                    IfCondition EqualTo(pre, 1) ThenBlock: {
                        Feed.DoGetPost(conn, path)
                        Arena_ScratchEnd()
                        ReturnValue(0)
                    }
                }
            }
            Feed.Err(conn, 404, "not found")
            Arena_ScratchEnd()
            ReturnValue(0)
        }
        IfCondition EqualTo(m0, 80) ThenBlock: {
            is_post = StringCompare(method, "POST")
            IfCondition NotEqual(is_post, 0) ThenBlock: {
                Feed.Err(conn, 404, "not found")
                ReturnValue(0)
            }
            pcmp = StringCompare(path, "/posts")
            IfCondition EqualTo(pcmp, 0) ThenBlock: {
                Feed.DoCreate(conn)
                ReturnValue(0)
            }
            pre2 = Feed.Starts(path, "/posts/")
            IfCondition EqualTo(pre2, 1) ThenBlock: {
                Feed.DoLike(conn, path)
                ReturnValue(0)
            }
            Feed.Err(conn, 404, "not found")
            ReturnValue(0)
        }
        Feed.Err(conn, 404, "not found")
    }
}

FixedPool.Feed {
    "SYNC_TAG": Initialize=63
}

// Tagged eventfds: the syncer, or a front's request ring
Function.Feed.Ring {
    Input: n: Integer
    Body: {
        IfCondition EqualTo(n, Feed.SYNC_TAG) ThenBlock: {
            SQLite.SyncDone()
            HTTP1.FlushPending()
            ReturnValue(0)
        }
        Front.OnReq(n)
    }
}

SubRoutine.Main {
    // Lazily built tables must not come from the scratch arena used in Auth
    Crypto.EnsureInit()
    FeedSt.uname = Allocate(256)
    FeedSt.body = Allocate(512)
    FeedSt.out = Allocate(Add(FeedSt.cap, 64))
    Feed.Init()
    FeedSt.ts = Allocate(16)
    FeedSt.iso = Allocate(32)
    MemorySet(FeedSt.ts, 0, 16)
    FeedSt.start = Feed.NowUnix()
    // clock_gettime through the vDSO: no kernel entry per JWT expiry check
    VDSO.Init()
    path = Env.Get("SQLITE_PATH")
    IfCondition EqualTo(path, 0) ThenBlock: {
        PrintMessage("FAIL SQLITE_PATH\n")
        Exit(1)
    }
    secret = Env.Get("JWT_SECRET")
    IfCondition EqualTo(secret, 0) ThenBlock: {
        secret = "twelve-dollar-challenge"
    }
    FeedSt.secret = secret
    host = Env.Get("HOST")
    IfCondition EqualTo(host, 0) ThenBlock: {
        host = "127.0.0.1"
    }
    port = Env.GetInt("PORT")
    IfCondition EqualTo(port, 0) ThenBlock: {
        port = 3000
    }
    ns = Env.GetInt("HTTP_NSLOT")
    IfCondition EqualTo(ns, 0) ThenBlock: { ns = 8192 }
    HTTP1St.nslot = ns
    HTTP1St.evmax = 256
    bz = Env.GetInt("HTTP_BUFSZ")
    IfCondition EqualTo(bz, 0) ThenBlock: { bz = 8192 }
    HTTP1St.bufsz = bz
    // Front processes each hold up to HTTP_NSLOT more connections on their
    // own descriptor limit. Forked before the database opens.
    fronts = Env.GetInt("HTTP_FRONTS")
    // Direct descriptors live in io_uring file tables, not the fd table, so one
    // process holds connections past the descriptor limit without fronts
    HTTP1St.direct = Env.GetInt("HTTP_DIRECT")
    IfCondition EqualTo(HTTP1St.direct, 1) ThenBlock: { fronts = 0 }
    HTTP1St.rxmulti = Env.GetInt("HTTP_RXMULTI")
    HTTP1St.stats = Env.GetInt("HTTP_STATS")
    // A pass waits for HTTP_WAIT_MIN completions or HTTP_WAIT_US, whichever comes
    // first. 0 keeps the default: wait for one completion, no timeout.
    HTTP1St.wait_min = Env.GetInt("HTTP_WAIT_MIN")
    HTTP1St.wait_us = Env.GetInt("HTTP_WAIT_US")
    pn = Env.GetInt("HTTP_PBUF_N")
    IfCondition GreaterThan(pn, 0) ThenBlock: { HTTP1St.pbuf_n = pn }
    pz = Env.GetInt("HTTP_PBUF_SZ")
    IfCondition GreaterThan(pz, 0) ThenBlock: { HTTP1St.pbuf_sz = pz }
    IfCondition EqualTo(Env.GetInt("HTTP_DEFER_TASKRUN"), 1) ThenBlock: {
        IoUring.setup_flags = BitwiseOr(IoUringSetup.SINGLE_ISSUER, IoUringSetup.DEFER_TASKRUN)
    }
    IfCondition GreaterThan(fronts, 0) ThenBlock: {
        IfCondition EqualTo(Front.Setup(fronts), 0) ThenBlock: {
            PrintMessage("FAIL front setup\n")
            Exit(1)
        }
        me = Front.Fork()
        IfCondition GreaterEqual(me, 0) ThenBlock: {
            Front.Serve(host, port)
        }
        HTTP1St.reuseport = 1
    }
    // Every file write (WAL frames, checkpoints, fdatasync) runs in the I/O process
    // SQLITE_CKWORKER_OFF=1 keeps checkpoint syncs and write-back on the I/O ring
    IfCondition EqualTo(Env.GetInt("SQLITE_CKWORKER_OFF"), 1) ThenBlock: { SQLiteIo.want_ck = 0 }
    // SQLITE_CKPT_MB: WAL bytes between checkpoints (default 4); the WAL restarts at twice that
    ckmb = Env.GetInt("SQLITE_CKPT_MB")
    IfCondition GreaterThan(ckmb, 0) ThenBlock: {
        SQLiteDB.ckpt_at = Multiply(ckmb, 1048576)
        SQLiteDB.reset_at = Multiply(ckmb, 2097152)
    }
    SQLiteIo.slow = Env.GetInt("SQLITE_CKSLOW_MS")
    IfCondition LessThan(SQLiteIo.slow, 0) ThenBlock: { SQLiteIo.slow = 0 }
    IfCondition EqualTo(Env.GetInt("SQLITE_IO_INLINE"), 1) ThenBlock: { SQLiteIo.inline = 1 }
    SQLite.StartSyncer(path)
    dbok = SQLite.Open(path)
    FeedSt.ok = dbok
    IfCondition EqualTo(dbok, 0) ThenBlock: {
        PrintMessage("FAIL sqlite open\n")
        Exit(1)
    }
    SQLiteDB.auto_commit = 0
    HTTP1St.commit_fn = AddressOf(Feed.CommitBatch)
    // Write responses wait for their commit's mark from the I/O process
    IfCondition NotEqual(SQLiteIo.blk, 0) ThenBlock: {
        HTTP1St.done_ptr = Add(SQLiteIo.blk, 8)
        HTTP1St.wait_fn = AddressOf(Feed.WaitDone)
    }
    fd = HTTP1.Listen(host, port)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("FAIL listen\n")
        Exit(1)
    }
    IfCondition GreaterThan(fronts, 0) ThenBlock: { Front.Attach() }
    HTTP1St.ring_fn = AddressOf(Feed.Ring)
    IfCondition GreaterEqual(SQLiteDB.sync_done, 0) ThenBlock: {
        HTTP1.WatchFd(SQLiteDB.sync_done, Add(HTTP1Ring.TAG, Feed.SYNC_TAG))
    }
    PrintMessage("listening\n")
    HTTP1.Serve(AddressOf(FeedHandler))
    Exit(0)
}
RunTask(Main)
