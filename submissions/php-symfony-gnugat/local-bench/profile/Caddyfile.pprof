# Profiling: local-bench/Caddyfile.classic with the admin endpoint on, for Go's pprof.
{
	auto_https off
	admin localhost:2019

	frankenphp {
		num_threads 2
		max_threads 8
	}
}

# Classic mode: Symfony boots on every request, like with PHP-FPM.
http://:{$PORT} {
	bind {$HOST}
	root ./public
	rewrite * /index.php
	php
}
