+++ b/src/core/tcp_tuple_index.inc
@@ -0,0 +1,168 @@
+/* Optional IPv4 NO_SYS packet-demultiplexing index for lwIP 2.2.1.
+ * Intrusive storage preserves the original active and TIME_WAIT lists,
+ * their ordering, and the complete upstream comparisons and state machine.
+ * All methods run in lwIP's single core context. */
+#include <stdint.h>
+
+#if !NO_SYS || !LWIP_IPV4 || LWIP_IPV6 || LWIP_TCP_TUPLE_INDEX_BITS < 1 || LWIP_TCP_TUPLE_INDEX_BITS > 20
+#error "select 1..20 index bits only for the single-core IPv4 NO_SYS configuration"
+#endif
+#ifndef LWIP_RAND
+#error "provide port entropy through LWIP_RAND() for the tuple hash"
+#endif
+
+#define TCP_INDEX_COUNT (1U << LWIP_TCP_TUPLE_INDEX_BITS)
+static struct tcp_pcb *tcp_index_buckets[2][TCP_INDEX_COUNT];
+static uint64_t tcp_index_key[2];
+static u8_t tcp_index_ready;
+static u32_t tcp_index_unresolved[2];
+
+static uint64_t
+tcp_index_rotl(uint64_t value, unsigned bits)
+{
+  return (value << bits) | (value >> (64 - bits));
+}
+
+/* SipHash-2-4 over the 12-byte TCP 4-tuple. Keys live for one stack lifetime. */
+static void
+tcp_index_round(uint64_t *a, uint64_t *b, uint64_t *c, uint64_t *d)
+{
+  *a += *b; *b = tcp_index_rotl(*b, 13) ^ *a; *a = tcp_index_rotl(*a, 32);
+  *c += *d; *d = tcp_index_rotl(*d, 16) ^ *c;
+  *a += *d; *d = tcp_index_rotl(*d, 21) ^ *a;
+  *c += *b; *b = tcp_index_rotl(*b, 17) ^ *c; *c = tcp_index_rotl(*c, 32);
+}
+
+static u32_t
+tcp_index_slot(const ip_addr_t *local, const ip_addr_t *remote, u16_t lport, u16_t rport)
+{
+  uint64_t a, b, c, d;
+  uint64_t m = (uint64_t)ip4_addr_get_u32(remote) << 32 | ip4_addr_get_u32(local);
+  uint64_t tail = (UINT64_C(12) << 56) | ((uint64_t)rport << 16) | lport;
+  unsigned i;
+  if (!tcp_index_ready) {
+    for (i = 0; i < 2; i++) {
+      uint64_t high = LWIP_RAND();
+      tcp_index_key[i] = (high << 32) | (u32_t)LWIP_RAND();
+    }
+    tcp_index_ready = 1;
+  }
+  a = UINT64_C(0x736f6d6570736575) ^ tcp_index_key[0];
+  b = UINT64_C(0x646f72616e646f6d) ^ tcp_index_key[1];
+  c = UINT64_C(0x6c7967656e657261) ^ tcp_index_key[0];
+  d = UINT64_C(0x7465646279746573) ^ tcp_index_key[1];
+  d ^= m;
+  for (i = 0; i < 2; i++) tcp_index_round(&a, &b, &c, &d);
+  a ^= m; d ^= tail;
+  for (i = 0; i < 2; i++) tcp_index_round(&a, &b, &c, &d);
+  a ^= tail; c ^= 0xff;
+  for (i = 0; i < 4; i++) tcp_index_round(&a, &b, &c, &d);
+  return (u32_t)(a ^ b ^ c ^ d) & (TCP_INDEX_COUNT - 1);
+}
+
+static struct tcp_pcb **
+tcp_index_bucket(struct tcp_pcb **list, const struct tcp_pcb *pcb)
+{
+  return &tcp_index_buckets[list == &tcp_tw_pcbs][tcp_index_slot(
+      &pcb->local_ip, &pcb->remote_ip, pcb->local_port, pcb->remote_port)];
+}
+
+struct tcp_pcb *
+tcp_index_input_head(int timewait, const ip_addr_t *local, const ip_addr_t *remote,
+                     u16_t lport, u16_t rport, int *full)
+{
+  *full = tcp_index_unresolved[timewait] != 0;
+  if (*full) return timewait ? tcp_tw_pcbs : tcp_active_pcbs;
+  return tcp_index_buckets[timewait][tcp_index_slot(local, remote, lport, rport)];
+}
+
+static void
+tcp_index_push(struct tcp_pcb **bucket, struct tcp_pcb *pcb)
+{
+  pcb->tuple_hash_prev = bucket;
+  pcb->tuple_next = *bucket;
+  if (*bucket != NULL) (*bucket)->tuple_hash_prev = &pcb->tuple_next;
+  *bucket = pcb;
+}
+
+static void
+tcp_index_unhash(struct tcp_pcb *pcb)
+{
+  *pcb->tuple_hash_prev = pcb->tuple_next;
+  if (pcb->tuple_next != NULL) pcb->tuple_next->tuple_hash_prev = pcb->tuple_hash_prev;
+  pcb->tuple_hash_prev = NULL;
+  pcb->tuple_next = NULL;
+}
+
+void
+tcp_index_register(struct tcp_pcb **list, struct tcp_pcb *pcb)
+{
+  if (list != &tcp_active_pcbs && list != &tcp_tw_pcbs) return;
+  /* In upstream normal connect and accept paths the tuple is complete.
+   * Upstream tests and private core extensions may register an empty PCB
+   * before populating its tuple. Keep those lists on original traversal. */
+  if (!pcb->local_port || !pcb->remote_port || ip_addr_isany(&pcb->local_ip) || ip_addr_isany(&pcb->remote_ip)) {
+    pcb->tuple_hash_prev = NULL;
+    pcb->tuple_next = NULL;
+    tcp_index_unresolved[list == &tcp_tw_pcbs]++;
+  } else {
+    tcp_index_push(tcp_index_bucket(list, pcb), pcb);
+  }
+  pcb->tuple_list_prev = NULL;
+  if (*list != NULL) (*list)->tuple_list_prev = pcb;
+}
+
+/* The slow timer captures pcb->next after unlinking the PCB. */
+static int
+tcp_index_forget(struct tcp_pcb **list, struct tcp_pcb *pcb)
+{
+  int tw;
+  if (list != &tcp_active_pcbs && list != &tcp_tw_pcbs) return 0;
+  tw = list == &tcp_tw_pcbs;
+  if (pcb->tuple_hash_prev != NULL) {
+    tcp_index_unhash(pcb);
+  } else if (tcp_index_unresolved[tw] != 0 && (pcb->tuple_list_prev != NULL || *list == pcb)) {
+    tcp_index_unresolved[tw]--;
+  } else {
+    return 0;
+  }
+  if (pcb->next != NULL) pcb->next->tuple_list_prev = pcb->tuple_list_prev;
+  pcb->tuple_list_prev = NULL;
+  return 1;
+}
+
+int
+tcp_index_remove(struct tcp_pcb **list, struct tcp_pcb *pcb)
+{
+  struct tcp_pcb *prev;
+  if (list != &tcp_active_pcbs && list != &tcp_tw_pcbs) return 0;
+  prev = pcb->tuple_list_prev;
+  if (!tcp_index_forget(list, pcb)) return 0;
+  if (prev == NULL) *list = pcb->next;
+  else prev->next = pcb->next;
+  pcb->next = NULL;
+  return 1;
+}
+
+void
+tcp_index_promote(struct tcp_pcb *pcb, int move_bucket)
+{
+  struct tcp_pcb *prev = pcb->tuple_list_prev;
+  if (prev == NULL) {
+    TCP_STATS_INC(tcp.cachehit);
+    return;
+  }
+  if (move_bucket && pcb->tuple_hash_prev != NULL) {
+    struct tcp_pcb **head = tcp_index_bucket(&tcp_active_pcbs, pcb);
+    if (*head != pcb) {
+      tcp_index_unhash(pcb);
+      tcp_index_push(head, pcb);
+    }
+  }
+  prev->next = pcb->next;
+  if (pcb->next != NULL) pcb->next->tuple_list_prev = prev;
+  pcb->next = tcp_active_pcbs;
+  tcp_active_pcbs->tuple_list_prev = pcb;
+  tcp_active_pcbs = pcb;
+  pcb->tuple_list_prev = NULL;
+}
