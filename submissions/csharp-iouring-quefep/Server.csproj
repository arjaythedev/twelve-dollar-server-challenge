<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>server</AssemblyName>
    <RootNamespace>Feed</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <!-- "native" fails in ilc on AVX-512 machines (Vector256); AVX2 is safe on the benchmark Xeon. -->
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
    <IlcMaxVectorTBitWidth>256</IlcMaxVectorTBitWidth>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <StackTraceSupport>false</StackTraceSupport>
    <!-- gcc links the native image, so the toolchain is the same one that builds SQLite. -->
    <CppCompilerAndLinker>gcc</CppCompilerAndLinker>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <DirectPInvoke Include="sqlite3" />
    <NativeLibrary Include="obj/sqlite/libsqlite3.a" />
    <DirectPInvoke Include="libc" />
  </ItemGroup>

</Project>
