# Another submission on the same stand-in box, built like ours: install.sh as root, build.sh as a normal user.
# Build context: a clean copy of the submission folder; serve.sh comes from the "bench" context (see bench.sh build-peer).
FROM ubuntu:24.04 AS runtime

COPY install.sh /tmp/install.sh
RUN bash /tmp/install.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends jq openssl procps \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home app

FROM runtime
COPY --chown=app:app . /app
USER app
RUN bash /app/build.sh

COPY --from=bench --chmod=755 serve.sh /usr/local/bin/serve
CMD ["serve"]
