-                auto &request = *static_cast<Request *>(parser->data);
-                if (parser->status_code < 200 && parser->status_code != 101)
-                {
-                    return 0;
-                }
-                request.complete = true;
-                request.keep_alive = llhttp_should_keep_alive(parser) != 0;
