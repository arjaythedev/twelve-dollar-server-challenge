--- /dev/null
+++ b/src/core/tcp_slow_work.inc
@@ -0,0 +1,221 @@
+/* Single-owner NO_SYS scheduler for the pinned IPv4 raw API port. */
+#include <stdlib.h>
+
+#define TCP_SLOW_SLOTS 256U
+#define TCP_SLOW_MAX_DUE 32768U
+#define TCP_SLOW_MAX_SLEEP 127U
+
+struct tcp_slow_due_entry {
+  u64_t order;
+  struct tcp_pcb *pcb;
+};
+static struct tcp_pcb *tcp_slow_slots[TCP_SLOW_SLOTS];
+static u32_t tcp_slow_counts[TCP_SLOW_SLOTS];
+static struct tcp_slow_due_entry tcp_slow_due[TCP_SLOW_MAX_DUE];
+static u32_t tcp_slow_active_count, tcp_slow_count, tcp_slow_pos;
+static u8_t tcp_slow_running, tcp_slow_sparse, tcp_slow_synced;
+static struct tcp_pcb *tcp_slow_current;
+static u64_t tcp_slow_order;
+
+static void
+tcp_slow_unlink(struct tcp_pcb *pcb)
+{
+  if (pcb->slow_prev) {
+    *pcb->slow_prev = pcb->slow_next;
+    if (pcb->slow_next) pcb->slow_next->slow_prev = pcb->slow_prev;
+    --tcp_slow_counts[pcb->slow_slot];
+    pcb->slow_prev = NULL;
+    pcb->slow_next = NULL;
+  }
+}
+
+static void
+tcp_slow_schedule(struct tcp_pcb *pcb, unsigned delay)
+{
+  const u8_t slot = (u8_t)(tcp_ticks + delay);
+  if (pcb->slow_prev && pcb->slow_slot == slot) return;
+  tcp_slow_unlink(pcb);
+  pcb->slow_next = tcp_slow_slots[slot];
+  if (pcb->slow_next) pcb->slow_next->slow_prev = &pcb->slow_next;
+  tcp_slow_slots[slot] = pcb;
+  pcb->slow_prev = &tcp_slow_slots[slot];
+  pcb->slow_slot = slot;
+  ++tcp_slow_counts[slot];
+}
+
+/* Only a fully inert PCB is parked, and never past its next poll or probe. */
+static void
+tcp_slow_materialize(struct tcp_pcb *pcb, u32_t through)
+{
+  if (pcb->slow_parked) {
+    pcb->polltmr = (u8_t)(pcb->polltmr + (u8_t)(through - pcb->slow_stamp));
+    pcb->slow_stamp = through;
+  }
+}
+
+/* Before the first external callback in a tick, expose exactly the partial
+ * upstream scan to the application. In particular a callback can inspect or
+ * remove an arbitrary peer, insert a new one, or make a new peer runnable. */
+static void
+tcp_slow_before_callback(void)
+{
+  struct tcp_pcb *pcb;
+  if (!tcp_slow_running || tcp_slow_synced) return;
+  for (pcb = tcp_active_pcbs; pcb != NULL; pcb = pcb->next) {
+    int passed = pcb->fast_order > tcp_slow_order || pcb->last_timer == tcp_timer_ctr;
+    if (pcb->slow_parked) tcp_slow_materialize(pcb, passed ? tcp_ticks : tcp_ticks - 1);
+    if (passed) pcb->last_timer = tcp_timer_ctr;
+  }
+  tcp_slow_sparse = 0;
+  tcp_slow_synced = 1;
+}
+
+static void
+tcp_slow_register(struct tcp_pcb *pcb)
+{
+  if (tcp_slow_running) tcp_slow_before_callback();
+  pcb->slow_stamp = tcp_ticks;
+  pcb->slow_parked = 0;
+  ++tcp_slow_active_count;
+  tcp_slow_schedule(pcb, 1);
+}
+
+static void
+tcp_slow_remove(struct tcp_pcb *pcb)
+{
+  if (tcp_slow_running && pcb != tcp_slow_current) tcp_slow_before_callback();
+  tcp_slow_unlink(pcb);
+  pcb->slow_parked = 0;
+  --tcp_slow_active_count;
+}
+
+void
+tcp_slow_work_wake(struct tcp_pcb *pcb)
+{
+  u32_t through;
+  if (!pcb->slow_parked) return;
+  if (tcp_slow_running && pcb != tcp_slow_current) tcp_slow_before_callback();
+  through = tcp_ticks;
+  if (tcp_slow_running && pcb->last_timer != tcp_timer_ctr) --through;
+  tcp_slow_materialize(pcb, through);
+  pcb->slow_parked = 0;
+  tcp_slow_schedule(pcb, 1);
+}
+
+static unsigned
+tcp_slow_delay(const struct tcp_pcb *pcb, u32_t from)
+{
+  unsigned delay;
+  u32_t age, limit, probe, death;
+  if (!pcb->slow_enrolled || pcb->state != ESTABLISHED || pcb->rtime >= 0 || pcb->rto <= 0 ||
+      pcb->nrtx || pcb->persist_backoff || pcb->unsent || pcb->unacked || pcb->refused_data ||
+      (pcb->flags & (TF_CLOSEPEND | TF_RXCLOSED | TF_FIN | TF_RTO | TF_NAGLEMEMERR)) ||
+      pcb->pollinterval <= 2 || pcb->polltmr >= pcb->pollinterval) return 1;
+#if TCP_QUEUE_OOSEQ
+  if (pcb->ooseq) return 1;
+#endif
+#if LWIP_CALLBACK_API
+  if (pcb->poll) return 1;
+#endif
+  delay = (unsigned)pcb->pollinterval - pcb->polltmr;
+  if (ip_get_option(pcb, SOF_KEEPALIVE)) {
+    /* Mirror the upstream unsigned arithmetic, including > and wraparound. */
+    age = (u32_t)(from - pcb->tmr);
+    probe = (pcb->keep_idle + pcb->keep_cnt_sent * TCP_KEEP_INTVL(pcb)) / TCP_SLOW_INTERVAL;
+    death = (pcb->keep_idle + TCP_KEEP_DUR(pcb)) / TCP_SLOW_INTERVAL;
+    limit = LWIP_MIN(probe, death);
+    if (age >= limit) return 1;
+    delay = (unsigned)LWIP_MIN((u32_t)delay, limit - age + 1);
+  }
+  return LWIP_MIN(delay, TCP_SLOW_MAX_SLEEP);
+}
+
+void
+tcp_slow_work_enroll(struct tcp_pcb *pcb)
+{
+  unsigned delay;
+  if (tcp_slow_running) tcp_slow_before_callback();
+  tcp_slow_work_wake(pcb);
+  pcb->slow_enrolled = 1;
+  if (tcp_slow_running || !pcb->slow_prev) return;
+  delay = tcp_slow_delay(pcb, tcp_ticks);
+  if (delay > 1) {
+    pcb->slow_parked = 1;
+    pcb->slow_stamp = tcp_ticks;
+    tcp_slow_schedule(pcb, delay);
+  }
+}
+
+static int
+tcp_slow_compare(const void *a, const void *b)
+{
+  const struct tcp_slow_due_entry *x = (const struct tcp_slow_due_entry *)a;
+  const struct tcp_slow_due_entry *y = (const struct tcp_slow_due_entry *)b;
+  return (x->order < y->order) - (x->order > y->order);
+}
+
+static void
+tcp_slow_begin(void)
+{
+  struct tcp_pcb *pcb;
+  u8_t slot = (u8_t)tcp_ticks;
+  tcp_slow_count = tcp_slow_counts[slot];
+  tcp_slow_pos = 0;
+  tcp_slow_running = 1;
+  tcp_slow_synced = 0;
+  tcp_slow_current = NULL;
+  tcp_slow_order = UINT64_MAX;
+  tcp_slow_sparse = tcp_slow_count <= TCP_SLOW_MAX_DUE &&
+                    tcp_slow_count <= tcp_slow_active_count / 2 &&
+                    (u8_t)(tcp_timer_ctr - tcp_last_full_timer) < 128;
+  if (tcp_slow_sparse) {
+    u32_t i = 0;
+    for (pcb = tcp_slow_slots[slot]; pcb != NULL; pcb = pcb->slow_next) {
+      tcp_slow_due[i].order = pcb->fast_order;
+      tcp_slow_due[i++].pcb = pcb;
+    }
+    if (i > 1) qsort(tcp_slow_due, i, sizeof(tcp_slow_due[0]), tcp_slow_compare);
+  } else {
+    tcp_last_full_timer = tcp_timer_ctr;
+  }
+}
+
+static struct tcp_pcb *
+tcp_slow_next(struct tcp_pcb *ordinary_next)
+{
+  struct tcp_pcb *pcb = ordinary_next;
+  if (tcp_slow_sparse)
+    pcb = tcp_slow_pos < tcp_slow_count ? tcp_slow_due[tcp_slow_pos++].pcb : NULL;
+  tcp_slow_current = pcb;
+  if (pcb) tcp_slow_order = pcb->fast_order;
+  return pcb;
+}
+
+/* Return true only when the sole upstream effect this tick is ++polltmr. */
+static int
+tcp_slow_prepare(struct tcp_pcb *pcb)
+{
+  const u32_t previous = tcp_ticks - 1;
+  unsigned delay;
+  tcp_slow_materialize(pcb, previous);
+  pcb->slow_parked = 0;
+  pcb->slow_stamp = tcp_ticks;
+  delay = tcp_slow_delay(pcb, previous);
+  if (delay > 1) {
+    ++pcb->polltmr;
+    pcb->slow_parked = 1;
+    tcp_slow_schedule(pcb, delay - 1);
+    return 1;
+  }
+  tcp_slow_schedule(pcb, 1);
+  return 0;
+}
+
+static void
+tcp_slow_seen(struct tcp_pcb *pcb)
+{
+  if (pcb->slow_prev && pcb->slow_slot == (u8_t)tcp_ticks) {
+    /* A callback can register a just-allocated PCB in the middle of a tick. */
+    tcp_slow_schedule(pcb, 1);
+  }
+}
