+            code = write_cli_workload(config, output)
+            telemetry = mapping(read_json(output / "telemetry.json"))
+            telemetry.update(complete=False, dropped_events=3)
+            write_json(output / "telemetry.json", telemetry)
+            return code
+
+        with TemporaryDirectory() as directory:
+            root = Path(directory)
