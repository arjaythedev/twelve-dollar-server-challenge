{
  "name": "twelve-dollar-elysia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server/main.ts",
    "build": "bun build --compile --production --target bun --outfile bin/server src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "knip": "knip"
  },
  "dependencies": {
    "elysia": "2.0.0-beta.31",
    "exact-mirror": "1.2.6",
    "typebox": "1.3.37"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "knip": "6.41.0",
    "typescript": "7.0.2"
  }
}
