// Library.Crypto.ailang — SHA-256, HMAC-SHA256, Base64URL, JWT HS256
//
// Software SHA-256 (FIPS 180-4). Single-threaded: compression state lives
// in FixedPools. SHA-NI can replace SHA256 later without changing callers.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering.
// Released under the MIT License, as required for submissions to this challenge.

LibraryImport.Arena
LibraryImport.JSON

FixedPool.CryptoSt {
    "ktab": Initialize=0, CanChange=True
    "wtab": Initialize=0, CanChange=True
    "pad": Initialize=0, CanChange=True
    "inited": Initialize=0, CanChange=True
}

FixedPool.SHA256H {
    "h0": Initialize=0, CanChange=True
    "h1": Initialize=0, CanChange=True
    "h2": Initialize=0, CanChange=True
    "h3": Initialize=0, CanChange=True
    "h4": Initialize=0, CanChange=True
    "h5": Initialize=0, CanChange=True
    "h6": Initialize=0, CanChange=True
    "h7": Initialize=0, CanChange=True
}

FixedPool.SHA256W {
    "a": Initialize=0, CanChange=True
    "b": Initialize=0, CanChange=True
    "c": Initialize=0, CanChange=True
    "d": Initialize=0, CanChange=True
    "e": Initialize=0, CanChange=True
    "f": Initialize=0, CanChange=True
    "g": Initialize=0, CanChange=True
    "h": Initialize=0, CanChange=True
    "t1": Initialize=0, CanChange=True
    "t2": Initialize=0, CanChange=True
}

FixedPool.JWTOut {
    "uid": Initialize=0, CanChange=True
    "name": Initialize=0, CanChange=True
}

Function.Crypto.U32 {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(n, 4294967295))
    }
}

Function.Crypto.Rotr {
    Input: x: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        ux = BitwiseAnd(x, 4294967295)
        left_n = Subtract(32, n)
        hi = RightShift(ux, n)
        lo = LeftShift(ux, left_n)
        ReturnValue(BitwiseAnd(BitwiseOr(hi, lo), 4294967295))
    }
}

Function.Crypto.Ch {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        ux = BitwiseAnd(x, 4294967295)
        uy = BitwiseAnd(y, 4294967295)
        uz = BitwiseAnd(z, 4294967295)
        n_x = BitwiseXor(ux, 4294967295)
        xy = BitwiseAnd(ux, uy)
        nxz = BitwiseAnd(n_x, uz)
        ReturnValue(BitwiseAnd(BitwiseXor(xy, nxz), 4294967295))
    }
}

Function.Crypto.Maj {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        ux = BitwiseAnd(x, 4294967295)
        uy = BitwiseAnd(y, 4294967295)
        uz = BitwiseAnd(z, 4294967295)
        xy = BitwiseAnd(ux, uy)
        xz = BitwiseAnd(ux, uz)
        yz = BitwiseAnd(uy, uz)
        t = BitwiseXor(xy, xz)
        ReturnValue(BitwiseAnd(BitwiseXor(t, yz), 4294967295))
    }
}

Function.Crypto.BSIG0 {
    Input: x: Integer
    Output: Integer
    Body: {
        r2 = Crypto.Rotr(x, 2)
        r13 = Crypto.Rotr(x, 13)
        r22 = Crypto.Rotr(x, 22)
        t = BitwiseXor(r2, r13)
        ReturnValue(BitwiseXor(t, r22))
    }
}

Function.Crypto.BSIG1 {
    Input: x: Integer
    Output: Integer
    Body: {
        r6 = Crypto.Rotr(x, 6)
        r11 = Crypto.Rotr(x, 11)
        r25 = Crypto.Rotr(x, 25)
        t = BitwiseXor(r6, r11)
        ReturnValue(BitwiseXor(t, r25))
    }
}

Function.Crypto.SSIG0 {
    Input: x: Integer
    Output: Integer
    Body: {
        r7 = Crypto.Rotr(x, 7)
        r18 = Crypto.Rotr(x, 18)
        shr = RightShift(BitwiseAnd(x, 4294967295), 3)
        t = BitwiseXor(r7, r18)
        ReturnValue(BitwiseXor(t, shr))
    }
}

Function.Crypto.SSIG1 {
    Input: x: Integer
    Output: Integer
    Body: {
        r17 = Crypto.Rotr(x, 17)
        r19 = Crypto.Rotr(x, 19)
        shr = RightShift(BitwiseAnd(x, 4294967295), 10)
        t = BitwiseXor(r17, r19)
        ReturnValue(BitwiseXor(t, shr))
    }
}

Function.Crypto.LoadBE32 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(buf, off)
        b1 = GetByte(buf, Add(off, 1))
        b2 = GetByte(buf, Add(off, 2))
        b3 = GetByte(buf, Add(off, 3))
        s1 = LeftShift(b0, 24)
        s2 = LeftShift(b1, 16)
        s3 = LeftShift(b2, 8)
        t = BitwiseOr(s1, s2)
        t2 = BitwiseOr(t, s3)
        ReturnValue(BitwiseOr(t2, b3))
    }
}

Function.Crypto.StoreBE32 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        u = BitwiseAnd(val, 4294967295)
        SetByte(buf, off, BitwiseAnd(RightShift(u, 24), 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(RightShift(u, 16), 255))
        SetByte(buf, Add(off, 2), BitwiseAnd(RightShift(u, 8), 255))
        SetByte(buf, Add(off, 3), BitwiseAnd(u, 255))
    }
}

Function.Crypto.StoreBE64 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        hi = RightShift(val, 32)
        Crypto.StoreBE32(buf, off, hi)
        Crypto.StoreBE32(buf, Add(off, 4), val)
    }
}

Function.Crypto.KSet {
    Input: i: Integer
    Input: val: Integer
    Body: {
        StoreValue(Add(CryptoSt.ktab, Multiply(i, 8)), val)
    }
}

Function.Crypto.FillK {
