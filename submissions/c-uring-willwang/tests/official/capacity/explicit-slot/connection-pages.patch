+enum { CONNECTION_BANK_BYTES = 2 * 1024 * 1024 };
+
+static Connection *allocate_connections(Ring *r) {
+    const size_t size = CONNECTION_BANK_BYTES;
+    if (slots == 65535 && (size_t)(slots + 1) * sizeof(Connection) == size) {
+        /* The kernel zeroes an anonymous bank on first use. Align it to one
+         * PMD so ordinary transparent huge pages can cover the whole bank. */
+        char *base = mmap(NULL, 2 * size, PROT_READ | PROT_WRITE,
+                          MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (base != MAP_FAILED) {
+            size_t prefix = -(uintptr_t)base & (size - 1);
+            char *aligned = base + prefix;
+            size_t suffix = size - prefix;
+            if (prefix && munmap(base, prefix)) {
+                munmap(base, 2 * size);
+            } else if (munmap(aligned + size, suffix)) {
+                munmap(aligned, size + suffix);
+            } else if (madvise(aligned, size, MADV_HUGEPAGE)) {
+                munmap(aligned, size);
+            } else {
+                r->conns_mapped = 1;
+                return (Connection *)aligned;
+            }
+        }
+    }
+    return calloc(slots, sizeof(Connection));
+}
