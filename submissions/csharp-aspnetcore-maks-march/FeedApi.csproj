<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FeedApi</RootNamespace>
    <AssemblyName>FeedApi</AssemblyName>

    <!-- No culture-sensitive code anywhere (ids, JSON, JS-style trim are all ordinal). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No hot-reload machinery in production. -->
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!-- The Web SDK defaults to server GC; on a single core with a tiny allocation rate the
         workstation concurrent collector gives shorter pauses. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!-- Exact NuGet versions, transitive ones included, are pinned in packages.lock.json. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <UserSecretsId>e59b5b41-a2df-4715-bd25-10c04ee96e1b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
