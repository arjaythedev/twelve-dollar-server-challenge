// Library.Env.ailang — process environment via /proc/self/environ
//
// Env.Get(name) returns a pointer into the loaded environ buffer (valid
// for the process lifetime, do not free), or 0 if the key is missing.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering.
// Released under the MIT License, as required for submissions to this challenge.

LibraryImport.Arena

FixedPool.EnvSys {
    "OPEN": Initialize=2
    "READ": Initialize=0
    "CLOSE": Initialize=3
    "O_RDONLY": Initialize=0
    "BUF_SIZE": Initialize=65536
}

FixedPool.EnvState {
    "buf": Initialize=0, CanChange=True
    "len": Initialize=0, CanChange=True
    "loaded": Initialize=0, CanChange=True
}

Function.Env.Load {
    Output: Integer
    Body: {
        IfCondition EqualTo(EnvState.loaded, 1) ThenBlock: {
            ReturnValue(1)
        }
        fd = SystemCall(EnvSys.OPEN, "/proc/self/environ", EnvSys.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(EnvSys.BUF_SIZE)
        n = SystemCall(EnvSys.READ, fd, buf, Subtract(EnvSys.BUF_SIZE, 1))
        SystemCall(EnvSys.CLOSE, fd, 0, 0)
        IfCondition LessThan(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        EnvState.buf = buf
        EnvState.len = n
        EnvState.loaded = 1
        ReturnValue(1)
    }
}

Function.Env.Get {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        ok = Env.Load()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = EnvState.buf
        nlen = EnvState.len
        i = 0
        WhileLoop LessThan(i, nlen) {
            m = 0
            matched = 1
            WhileLoop EqualTo(matched, 1) {
                nc = GetByte(name, m)
                IfCondition EqualTo(nc, 0) ThenBlock: {
                    eq = GetByte(buf, Add(i, m))
                    IfCondition EqualTo(eq, 61) ThenBlock: {
                        ReturnValue(Add(buf, Add(Add(i, m), 1)))
                    }
                    matched = 0
                } ElseBlock: {
                    bc = GetByte(buf, Add(i, m))
                    IfCondition NotEqual(bc, nc) ThenBlock: {
                        matched = 0
                    } ElseBlock: {
                        m = Add(m, 1)
                    }
                }
            }
            WhileLoop LessThan(i, nlen) {
                ch = GetByte(buf, i)
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    i = Add(i, 1)
                    BreakLoop
                }
                i = Add(i, 1)
            }
        }
        ReturnValue(0)
    }
}

Function.Env.GetInt {
    Input: name: Address
    Output: Integer
    Body: {
        s = Env.Get(name)
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue(0)
        }
        result = 0
        i = 0
        saw = 0
        WhileLoop 1 {
            ch = GetByte(s, i)
            IfCondition Or(LessThan(ch, 48), GreaterThan(ch, 57)) ThenBlock: {
                IfCondition EqualTo(saw, 0) ThenBlock: {
                    ReturnValue(0)
                }
                ReturnValue(result)
            }
            digit = Subtract(ch, 48)
            result = Add(Multiply(result, 10), digit)
            saw = 1
            i = Add(i, 1)
        }
        ReturnValue(result)
    }
}
