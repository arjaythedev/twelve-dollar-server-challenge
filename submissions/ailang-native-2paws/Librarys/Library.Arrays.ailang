}

// =============================================================================
// LINKED LIST
// =============================================================================

Function.List.Create {
    Output: Address
    Body: {
        Arrays_EnsureArena()
        list = Arena_Alloc24()
        StoreValue(list, 0)
        StoreValue(Add(list, 8), 0)
        StoreValue(Add(list, 16), 0)
        ReturnValue(list)
    }
}

Function.List.Append {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        new_node = Arena_Alloc24()
        StoreValue(new_node, value)
        StoreValue(Add(new_node, 8), 0)
        head = Dereference(list)
        tail = Dereference(Add(list, 8))
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(list, new_node)
            StoreValue(Add(list, 8), new_node)
        } ElseBlock: {
            StoreValue(Add(tail, 8), new_node)
            StoreValue(Add(list, 8), new_node)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Add(size, 1))
        ReturnValue(1)
    }
}

Function.List.Prepend {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        new_node = Arena_Alloc24()
        StoreValue(new_node, value)
        head = Dereference(list)
        StoreValue(Add(new_node, 8), head)
        StoreValue(list, new_node)
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(Add(list, 8), new_node)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Add(size, 1))
        ReturnValue(1)
    }
}

Function.List.PopFront {
    Input: list: Address
    Output: Integer
    Body: {
        head = Dereference(list)
        IfCondition EqualTo(head, 0) ThenBlock: {
            ReturnValue(0)
        }
        value = Dereference(head)
        next_node = Dereference(Add(head, 8))
        StoreValue(list, next_node)
        IfCondition EqualTo(next_node, 0) ThenBlock: {
            StoreValue(Add(list, 8), 0)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Subtract(size, 1))
        Arena_Free24(head)
        ReturnValue(value)
    }
}

Function.List.PopBack {
    Input: list: Address
    Output: Integer
    Body: {
        tail = Dereference(Add(list, 8))
        IfCondition EqualTo(tail, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        IfCondition EqualTo(head, tail) ThenBlock: {
            value = Dereference(tail)
            Arena_Free24(tail)
            StoreValue(list, 0)
            StoreValue(Add(list, 8), 0)
            StoreValue(Add(list, 16), 0)
            ReturnValue(value)
        }
        current = head
        WhileLoop NotEqual(Dereference(Add(current, 8)), tail) {
            current = Dereference(Add(current, 8))
        }
        value = Dereference(tail)
        Arena_Free24(tail)
        StoreValue(Add(current, 8), 0)
        StoreValue(Add(list, 8), current)
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Subtract(size, 1))
        ReturnValue(value)
    }
}

Function.List.Size {
    Input: list: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(list, 16)))
    }
}

Function.List.Destroy {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        WhileLoop NotEqual(head, 0) {
            next = Dereference(Add(head, 8))
            Arena_Free24(head)
            head = next
        }
        Arena_Free24(list)
        ReturnValue(1)
    }
}

Function.List.DestroyDeep {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        WhileLoop NotEqual(head, 0) {
            next = Dereference(Add(head, 8))
            value = Dereference(head)
            IfCondition NotEqual(value, 0) ThenBlock: {
                value_len = StringLength(value)
                Deallocate(value, Add(value_len, 1))
            }
            Arena_Free24(head)
            head = next
        }
        Arena_Free24(list)
        ReturnValue(1)
    }
}

// =============================================================================
// UTILITY FUNCTIONS
// =============================================================================

Function.Util.BinarySearch {
    Input: arr: Address
    Input: target: Integer
    Output: Integer
    Body: {
        size = Array.Size(arr)
        left = 0
        right = Subtract(size, 1)
        WhileLoop LessEqual(left, right) {
            mid = Divide(Add(left, right), 2)
            mid_val = Array.Get(arr, mid)
            IfCondition EqualTo(mid_val, target) ThenBlock: {
                ReturnValue(mid)
            }
            IfCondition LessThan(mid_val, target) ThenBlock: {
                left = Add(mid, 1)
            } ElseBlock: {
                right = Subtract(mid, 1)
            }
        }
        ReturnValue(Collections.XNULL)
    }
}

Function.Util.QuickSort {
    Input: arr: Address
    Input: low: Integer
    Input: high: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(low, high) ThenBlock: {
            pivot_index = Util.Partition(arr, low, high)
            Util.QuickSort(arr, low, Subtract(pivot_index, 1))
            Util.QuickSort(arr, Add(pivot_index, 1), high)
        }
        ReturnValue(1)
    }
}

Function.Util.Partition {
    Input: arr: Address
    Input: low: Integer
    Input: high: Integer
    Output: Integer
    Body: {
        pivot = Array.Get(arr, high)
        i = Subtract(low, 1)
        j = low
        WhileLoop LessThan(j, high) {
            current = Array.Get(arr, j)
            IfCondition LessEqual(current, pivot) ThenBlock: {
                i = Add(i, 1)
                temp = Array.Get(arr, i)
                Array.Set(arr, i, current)
                Array.Set(arr, j, temp)
            }
            j = Add(j, 1)
        }
        i = Add(i, 1)
        temp = Array.Get(arr, i)
        Array.Set(arr, i, pivot)
        Array.Set(arr, high, temp)
        ReturnValue(i)
    }
}

Function.Util.FindMax {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Array.Size(arr)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(Collections.XERROR)
        }
        max_val = Array.Get(arr, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            current = Array.Get(arr, i)
            IfCondition GreaterThan(current, max_val) ThenBlock: {
                max_val = current
            }
            i = Add(i, 1)
        }
        ReturnValue(max_val)
    }
}

Function.Util.FindMin {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Array.Size(arr)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(Collections.XERROR)
        }
        min_val = Array.Get(arr, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            current = Array.Get(arr, i)
            IfCondition LessThan(current, min_val) ThenBlock: {
                min_val = current
            }
            i = Add(i, 1)
        }
        ReturnValue(min_val)
    }
}

Function.Util.Reverse {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Array.Size(arr)
        left = 0
        right = Subtract(size, 1)
        WhileLoop LessThan(left, right) {
            left_val = Array.Get(arr, left)
            right_val = Array.Get(arr, right)
            Array.Set(arr, left, right_val)
            Array.Set(arr, right, left_val)
            left = Add(left, 1)
            right = Subtract(right, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// STREAM OPERATIONS
// =============================================================================

Function.Stream.Destroy {
    Input: stream: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(stream, 0) ThenBlock: {
            size = Array.Size(stream)
            i = 0
            WhileLoop LessThan(i, size) {
                entry = Array.Get(stream, i)
                entry_size = Array.Size(entry)
                j = 0
                WhileLoop LessThan(j, entry_size) {
                    field_or_value = Array.Get(entry, j)
                    fv_len = StringLength(field_or_value)
                    Deallocate(field_or_value, Add(fv_len, 1))
                    j = Add(j, 1)
                }
                Array.Destroy(entry)
                i = Add(i, 1)
            }
            Array.Destroy(stream)
        }
        ReturnValue(1)
    }
}

