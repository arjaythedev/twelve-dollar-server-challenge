diff --git a/core/reios/hostfs.cpp b/core/reios/hostfs.cpp
new file mode 100644
index 0000000..8419b82
--- /dev/null
+++ b/core/reios/hostfs.cpp
@@ -0,0 +1,148 @@
+/*
+	hostfs: a tiny "BIOS" syscall that lets a guest program do page I/O on
+	one host file (and its -wal/-journal siblings), plus read two allow-listed
+	environment variables and the host clock.
+
+	Added for the dreamcast-sql joke entry of the $12 server challenge. The
+	guest calls 0x8C00100A with r4 = op and r5 = pointer to a u32 block:
+	  OPEN     blk[0]=suffix ptr, blk[1]=create          -> fd or -errno
+	  CLOSE    blk[0]=fd
+	  PREAD    blk[0]=fd blk[1]=buf blk[2]=len blk[3]=off -> bytes or -errno
+	  PWRITE   same as PREAD
+	  SIZE     blk[0]=fd                                -> size or -errno
+	  TRUNCATE blk[0]=fd blk[1]=size
+	  SYNC     blk[0]=fd
+	  DELETE   blk[0]=suffix ptr
+	  ACCESS   blk[0]=suffix ptr                         -> 1 if it exists
+	  GETENV   blk[0]=name ptr blk[1]=buf blk[2]=len    -> length or -1
+	  TIME     blk[0..1] <- unix time in ms (lo, hi)
+	  LOG      blk[0]=string ptr
+	The file is $HOSTFS_PATH; the suffix may only be "", "-wal" or "-journal".
+*/
+#include "hostfs.h"
+#include "hw/sh4/sh4_mem.h"
+#include "hw/sh4/sh4_if.h"
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+enum { HFS_OPEN, HFS_CLOSE, HFS_PREAD, HFS_PWRITE, HFS_SIZE, HFS_TRUNCATE, HFS_SYNC,
+	HFS_DELETE, HFS_ACCESS, HFS_GETENV, HFS_TIME, HFS_LOG };
+
+static bool guestString(u32 addr, std::string& out, size_t max)
+{
+	out.clear();
+	for (size_t i = 0; i < max; i++)
+	{
+		u8 *p = GetMemPtr(addr + i, 1);
+		if (p == nullptr)
+			return false;
+		if (*p == 0)
+			return true;
+		out += (char)*p;
+	}
+	return false;
+}
+
+static bool hostPath(u32 suffixAddr, std::string& path)
+{
+	std::string suffix;
+	const char *base = getenv("HOSTFS_PATH");
+	if (base == nullptr || !guestString(suffixAddr, suffix, 16))
+		return false;
+	if (suffix != "" && suffix != "-wal" && suffix != "-journal")
+		return false;
+	path = std::string(base) + suffix;
+	return true;
+}
+
+static s32 hostfs_call(u32 op, u32 *blk)
+{
+	std::string path;
+	switch (op)
+	{
+	case HFS_OPEN:
+	{
+		if (!hostPath(blk[0], path))
+			return -EACCES;
+		int fd = open(path.c_str(), O_RDWR | (blk[1] ? O_CREAT : 0), 0644);
+		return fd < 0 ? -errno : fd;
+	}
+	case HFS_CLOSE:
+		return close((int)blk[0]) < 0 ? -errno : 0;
+	case HFS_PREAD:
+	case HFS_PWRITE:
+	{
+		u8 *buf = GetMemPtr(blk[1], blk[2]);
+		if (buf == nullptr)
+			return -EFAULT;
+		ssize_t n = op == HFS_PREAD ? pread((int)blk[0], buf, blk[2], (off_t)blk[3])
+				: pwrite((int)blk[0], buf, blk[2], (off_t)blk[3]);
+		return n < 0 ? -errno : (s32)n;
+	}
+	case HFS_SIZE:
+	{
+		struct stat st;
+		if (fstat((int)blk[0], &st) < 0)
+			return -errno;
+		return st.st_size > 0x7fffffff ? -EFBIG : (s32)st.st_size;
+	}
+	case HFS_TRUNCATE:
+		return ftruncate((int)blk[0], (off_t)blk[1]) < 0 ? -errno : 0;
+	case HFS_SYNC:
+		return fsync((int)blk[0]) < 0 ? -errno : 0;
+	case HFS_DELETE:
+		if (!hostPath(blk[0], path))
+			return -EACCES;
+		return unlink(path.c_str()) < 0 && errno != ENOENT ? -errno : 0;
+	case HFS_ACCESS:
+		if (!hostPath(blk[0], path))
+			return -EACCES;
+		return access(path.c_str(), F_OK) == 0 ? 1 : 0;
+	case HFS_GETENV:
+	{
+		std::string name;
+		if (!guestString(blk[0], name, 32) || (name != "JWT_SECRET" && name != "PORT"))
+			return -1;
+		const char *v = getenv(name.c_str());
+		u8 *buf = GetMemPtr(blk[1], blk[2]);
+		if (v == nullptr || buf == nullptr || strlen(v) >= blk[2])
+			return -1;
+		memcpy(buf, v, strlen(v) + 1);
+		return (s32)strlen(v);
+	}
+	case HFS_TIME:
+	{
+		timeval tv;
+		gettimeofday(&tv, nullptr);
+		u64 ms = (u64)tv.tv_sec * 1000 + tv.tv_usec / 1000;
+		blk[0] = (u32)ms;
+		blk[1] = (u32)(ms >> 32);
+		return 0;
+	}
+	case HFS_LOG:
+	{
+		std::string s;
+		guestString(blk[0], s, 4096);
+		fprintf(stdout, "[dreamcast] %s\n", s.c_str());
+		fflush(stdout);
+		return 0;
+	}
+	default:
+		return -ENOSYS;
+	}
+}
+
+void hostfs_syscall()
+{
+	Sh4Context& ctx = p_sh4rcb->cntx;
+	u32 *blk = (u32 *)GetMemPtr(ctx.r[5], 16);
+	ctx.r[0] = blk == nullptr ? (u32)-EFAULT : (u32)hostfs_call(ctx.r[4], blk);
+}
