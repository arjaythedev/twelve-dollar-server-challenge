{
  "python.defaultInterpreterPath": "${workspaceFolder}/src/.venv",
  "python-envs.pythonProjects": [{ "path": "src", "envManager": "ms-python.python:venv" }],
  "python-envs.workspaceSearchPaths": ["./src/.venv"],
  "python-envs.alwaysUseUv": true,
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.analysis.exclude": ["**/.venv/**", "**/.native/**", "**/submissions/**"],
  "python.testing.cwd": "${workspaceFolder}/src",
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "checks", "-p", "test_*.py"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },
  "cmake.ignoreCMakeListsMissing": true
}
