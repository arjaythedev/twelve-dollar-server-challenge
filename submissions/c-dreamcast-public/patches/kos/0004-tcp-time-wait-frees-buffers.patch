+/* Enter TIME-WAIT. It only re-ACKs the peer's FIN, so once close() has been
+   called the data buffers (most of the socket's memory) can go now rather than
+   in 2 * MSL: a server that closes connections first would otherwise keep 16 KB
+   per connection for 30 seconds. */
+static void tcp_enter_time_wait(struct tcp_sock *s) {
+    s->state = TCP_STATE_TIME_WAIT;
+    s->data.timer = timer_ms_gettime64();
