<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>feed</AssemblyName>
    <RootNamespace>Feed</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <!-- With a native target, Native AOT fails with a Vector256 error on AVX-512 machines.
         build.sh lowers this to x86-64-v2 on a CPU without AVX2. -->
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- One thread does all the work: no background GC thread competing with it. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- There are no package references; the lock file pins the SDK's ILCompiler packages. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- build.sh compiles SQLite from source into this static library. SQLite and libc are called directly, with no lookup at run time. -->
    <DirectPInvoke Include="sqlite3" />
    <NativeLibrary Include="obj/sqlite/libsqlite3.a" />
    <DirectPInvoke Include="libc" />
  </ItemGroup>

</Project>
