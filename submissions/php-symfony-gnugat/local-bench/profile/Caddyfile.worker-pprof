# Profiling: the submitted Caddyfile (worker mode) with the admin endpoint on, for Go's pprof (see profile/memory.sh).
{
	auto_https off
	admin localhost:2019

	frankenphp {
		max_threads 8
		worker {
			file ./public/index.php
		}
	}
}

http://:{$PORT} {
	bind {$HOST}
	root ./public
	rewrite * /index.php
	php
}
