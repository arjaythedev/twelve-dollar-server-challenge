+++ b/pool_arena.odin
@@ -0,0 +1,187 @@
+package http
+
+import "base:runtime"
+import "core:mem"
+
+// Request-scoped memory for a connection, borrowed from a pool of fixed-size blocks only while a
+// request is being served: an idle keep-alive connection holds no block and no mapping.
+//
+// Allocations bump a pointer inside the block; anything that does not fit gets its own heap
+// allocation, freed together with the block on `free_all`.
+
+POOL_BLOCK_SIZE :: 16 * mem.Kilobyte
+
+@(private)
+Pool_Free :: struct {
+	next: ^Pool_Free,
+}
+
+@(private)
+Pool_Overflow :: struct {
+	next: ^Pool_Overflow,
+}
+
+// Per thread, so it needs no locking. Threads that never call `pool_init` use the heap.
+@(private, thread_local)
+block_pool: struct {
+	free:  ^Pool_Free,
+	start: uintptr,
+	end:   uintptr,
+}
+
+// Carves the calling thread's request blocks out of `slab` (which should be page aligned and
+// already touched). Once the slab runs out, blocks come from the heap and are returned to it.
+pool_init :: proc(slab: []byte) {
+	n := len(slab) / POOL_BLOCK_SIZE
+	block_pool.start = uintptr(raw_data(slab))
+	block_pool.end   = block_pool.start + uintptr(n * POOL_BLOCK_SIZE)
+	block_pool.free  = nil
+	for i := n - 1; i >= 0; i -= 1 {
+		b := (^Pool_Free)(&slab[i * POOL_BLOCK_SIZE])
+		b.next = block_pool.free
+		block_pool.free = b
+	}
+}
+
+@(private)
+pool_block_acquire :: proc() -> ([^]byte, mem.Allocator_Error) {
+	if b := block_pool.free; b != nil {
+		block_pool.free = b.next
+		return ([^]byte)(b), nil
+	}
+	raw, err := mem.alloc_bytes_non_zeroed(POOL_BLOCK_SIZE, 64, runtime.heap_allocator())
+	return raw_data(raw), err
+}
+
+@(private)
+pool_block_release :: proc(b: [^]byte) {
+	p := uintptr(b)
+	if p >= block_pool.start && p < block_pool.end {
+		f := (^Pool_Free)(b)
+		f.next = block_pool.free
+		block_pool.free = f
+	} else {
+		mem.free(b, runtime.heap_allocator())
+	}
+}
+
+Pool_Arena :: struct {
+	block:    [^]byte, // nil while idle
+	offset:   int,
+	last:     rawptr,  // last allocation inside the block, so it can grow or shrink in place
+	overflow: ^Pool_Overflow,
+}
+
+pool_arena_allocator :: proc(a: ^Pool_Arena) -> mem.Allocator {
+	return {procedure = pool_arena_proc, data = a}
+}
+
+// Returns the block (and any overflow allocations); the arena stays usable.
+pool_arena_free_all :: proc(a: ^Pool_Arena) {
+	for o := a.overflow; o != nil; {
+		next := o.next
+		mem.free(o, runtime.heap_allocator())
+		o = next
+	}
+	a.overflow = nil
+	if a.block != nil {
+		pool_block_release(a.block)
+		a.block = nil
+	}
+	a.offset = 0
+	a.last   = nil
+}
+
+@(private)
+pool_arena_alloc :: proc(a: ^Pool_Arena, size, alignment: int, zero: bool) -> (bytes: []byte, err: mem.Allocator_Error) {
+	if size <= 0 { return nil, nil }
+	alignment := max(alignment, 1)
+
+	if size <= POOL_BLOCK_SIZE / 2 {
+		if a.block == nil {
+			a.block  = pool_block_acquire() or_return
+			a.offset = 0
+		}
+		start := mem.align_forward_int(a.offset, alignment)
+		if start + size <= POOL_BLOCK_SIZE {
+			ptr := &a.block[start]
+			a.offset = start + size
+			a.last   = ptr
+			if zero { mem.zero(ptr, size) }
+			return mem.byte_slice(ptr, size), nil
+		}
+	}
+
+	align  := max(alignment, 16)
+	header := mem.align_forward_int(size_of(Pool_Overflow), align)
+	raw    := mem.alloc_bytes_non_zeroed(header + size, align, runtime.heap_allocator()) or_return
+	o := (^Pool_Overflow)(raw_data(raw))
+	o.next = a.overflow
+	a.overflow = o
+	ptr := &raw[header]
+	if zero { mem.zero(ptr, size) }
+	return mem.byte_slice(ptr, size), nil
+}
+
+@(private)
+pool_arena_proc :: proc(
+	allocator_data: rawptr,
+	mode: mem.Allocator_Mode,
+	size, alignment: int,
+	old_memory: rawptr,
+	old_size: int,
+	loc := #caller_location,
+) -> (bytes: []byte, err: mem.Allocator_Error) {
+	a := (^Pool_Arena)(allocator_data)
+
+	switch mode {
+	case .Alloc:
+		return pool_arena_alloc(a, size, alignment, true)
+
+	case .Alloc_Non_Zeroed:
+		return pool_arena_alloc(a, size, alignment, false)
+
+	case .Free:
+		if old_memory != nil && old_memory == a.last {
+			a.offset = int(uintptr(old_memory) - uintptr(a.block))
+			a.last   = nil
+		}
+		return nil, nil
+
+	case .Free_All:
+		pool_arena_free_all(a)
+		return nil, nil
+
+	case .Resize, .Resize_Non_Zeroed:
+		zero := mode == .Resize
+		if old_memory == nil {
+			return pool_arena_alloc(a, size, alignment, zero)
+		}
+		if old_memory == a.last {
+			start := int(uintptr(old_memory) - uintptr(a.block))
+			if start + size <= POOL_BLOCK_SIZE {
+				a.offset = start + size
+				if zero && size > old_size { mem.zero(&a.block[start + old_size], size - old_size) }
+				return mem.byte_slice(old_memory, size), nil
+			}
+		}
+		if size <= old_size {
+			return mem.byte_slice(old_memory, size), nil
+		}
+		new_memory := pool_arena_alloc(a, size, alignment, false) or_return
+		copy(new_memory, mem.byte_slice(old_memory, old_size))
+		if zero { mem.zero_slice(new_memory[old_size:]) }
+		return new_memory, nil
+
+	case .Query_Features:
+		set := (^mem.Allocator_Mode_Set)(old_memory)
+		if set != nil {
+			set^ = {.Alloc, .Alloc_Non_Zeroed, .Free, .Free_All, .Resize, .Resize_Non_Zeroed, .Query_Features}
+		}
+		return nil, nil
+
+	case .Query_Info:
+		return nil, .Mode_Not_Implemented
+	}
+	return nil, nil
+}
