#!/bin/sh
set -eu
dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
orig=/home/dev-user/code/twelve-dollar-server-challenge/submissions/c-uring-willwang/tests/official
case ${BENCH_TOPOLOGY:-ethernet} in
loopback) exec "$orig/run.sh" "$@" ;;
ethernet|router) work=$1; shift; exec python3 "$dir/eth_run.py" --work "$work" "$@" ;;
*) echo 'Unknown BENCH_TOPOLOGY' >&2; exit 2 ;;
esac
