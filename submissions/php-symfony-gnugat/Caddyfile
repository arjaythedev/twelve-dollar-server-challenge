{
	auto_https off
	admin off

	frankenphp {
		# Up to 8 PHP threads, from the 3 it starts with (the 2 workers, 1 for other scripts): FrankenPHP adds threads
		# when requests wait for a free one (while others wait on SQLite), and stops them once idle for max_idle_time.
		max_threads 8
		# Worker mode: Symfony boots once per thread, then handles requests in a loop.
		# Defaults: 2 workers (2 per CPU), restarted every 500 requests by symfony/runtime.
		worker {
			file ./public/index.php
		}
	}
}

http://:{$PORT} {
	bind {$HOST}
	root ./public
	# An API without static files: no try_files filesystem checks, everything goes to Symfony
	rewrite * /index.php
	php
}
