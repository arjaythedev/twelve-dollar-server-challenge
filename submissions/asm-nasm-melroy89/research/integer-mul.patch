--- a/src/server.asm
+++ b/src/server.asm
@@ -1105,15 +1105,37 @@
 append_uint:
  sub rsp,40
  lea rsi,[rsp+32]
+ cmp dword [integer_mode],0
+ jne .mul_start
  mov ecx,10
-.loop:
+.div_loop:
  xor edx,edx
  div rcx
  add dl,'0'
  dec rsi
  mov [rsi],dl
  test rax,rax
- jnz .loop
+ jnz .div_loop
+ jmp .copy
+.mul_start:
+ mov rcx,0xcccccccccccccccd
+.mul_loop:
+ ; q = high64(n * ceil(2^67/10)) >> 3, exact for every unsigned64 n.
+ ; The eight-byte slot above the reverse buffer is outside its20digit extent.
+ mov [rsp+32],rax
+ mul rcx
+ shr rdx,3
+ lea rax,[rdx+rdx*4]
+ add rax,rax
+ sub [rsp+32],rax
+ mov rax,[rsp+32]
+ add al,'0'
+ dec rsi
+ mov [rsi],al
+ mov rax,rdx
+ test rax,rax
+ jnz .mul_loop
+.copy:
  lea rcx,[rsp+32]
  sub rcx,rsi
  rep movsb
