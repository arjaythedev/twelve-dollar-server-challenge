+                                       10000000, 20000000, 60000000};
+enum { TICK_BUCKETS = sizeof(tick_limits) / sizeof(tick_limits[0]) + 1 };
+static uint32_t tick_latency[TICK_BUCKETS];
+static uint64_t tick_requests, tick_total_us;
+static FILE *tick_file;
+static void tick_record(uint64_t us) {
+    if (!tick_file) return;
+    unsigned bucket = 0;
+    while (bucket + 1 < TICK_BUCKETS && us > tick_limits[bucket]) bucket++;
+    tick_latency[bucket]++;
+    tick_requests++;
+    tick_total_us += us;
+}
+static void tick_report(int64_t now) {
+    fprintf(tick_file, "%.3f,%llu,%llu,%u", (double)(now - t_start) / 1e9,
+            (unsigned long long)tick_requests, (unsigned long long)tick_total_us,
+            active_connections);
+    for (unsigned i = 0; i < TICK_BUCKETS; ++i) fprintf(tick_file, ",%u", tick_latency[i]);
+    fputc('\n', tick_file);
+    fflush(tick_file);
+    memset(tick_latency, 0, sizeof tick_latency);
+    tick_requests = tick_total_us = 0;
+}
