// Library.Crypto.ailang — SHA-256, HMAC-SHA256, Base64URL, JWT HS256
//
// Software SHA-256 (FIPS 180-4). Single-threaded: compression state lives
// in FixedPools. SHA-NI can replace SHA256 later without changing callers.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering.
// Released under the MIT License, as required for submissions to this challenge.

LibraryImport.Arena
LibraryImport.JSON

FixedPool.CryptoSt {
    "ktab": Initialize=0, CanChange=True
    "wtab": Initialize=0, CanChange=True
    "pad": Initialize=0, CanChange=True
    "inited": Initialize=0, CanChange=True
    "istate": Initialize=0, CanChange=True
    "ostate": Initialize=0, CanChange=True
    "hkey": Initialize=0, CanChange=True
    "hkey_n": Initialize=-1, CanChange=True
}

FixedPool.SHA256H {
    "h0": Initialize=0, CanChange=True
    "h1": Initialize=0, CanChange=True
    "h2": Initialize=0, CanChange=True
    "h3": Initialize=0, CanChange=True
    "h4": Initialize=0, CanChange=True
    "h5": Initialize=0, CanChange=True
    "h6": Initialize=0, CanChange=True
    "h7": Initialize=0, CanChange=True
}

FixedPool.SHA256W {
    "a": Initialize=0, CanChange=True
    "b": Initialize=0, CanChange=True
    "c": Initialize=0, CanChange=True
    "d": Initialize=0, CanChange=True
    "e": Initialize=0, CanChange=True
    "f": Initialize=0, CanChange=True
    "g": Initialize=0, CanChange=True
    "h": Initialize=0, CanChange=True
    "t1": Initialize=0, CanChange=True
    "t2": Initialize=0, CanChange=True
}

FixedPool.JWTOut {
    "uid": Initialize=0, CanChange=True
    "name": Initialize=0, CanChange=True
}

Function.Crypto.StoreBE32 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        u = BitwiseAnd(val, 4294967295)
        WRMEM_8(buf, off, BitwiseAnd(RightShift(u, 24), 255))
        WRMEM_8(buf, Add(off, 1), BitwiseAnd(RightShift(u, 16), 255))
        WRMEM_8(buf, Add(off, 2), BitwiseAnd(RightShift(u, 8), 255))
        WRMEM_8(buf, Add(off, 3), BitwiseAnd(u, 255))
    }
}

Function.Crypto.StoreBE64 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        hi = RightShift(val, 32)
        Crypto.StoreBE32(buf, off, hi)
        Crypto.StoreBE32(buf, Add(off, 4), val)
    }
}

Function.Crypto.KSet {
    Input: i: Integer
    Input: val: Integer
    Body: {
        WRMEM_64(Add(CryptoSt.ktab, Multiply(i, 8)), val)
    }
}

Function.Crypto.FillK {
    Body: {
        Crypto.KSet(0, 0x428a2f98)
        Crypto.KSet(1, 0x71374491)
        Crypto.KSet(2, 0xb5c0fbcf)
        Crypto.KSet(3, 0xe9b5dba5)
        Crypto.KSet(4, 0x3956c25b)
        Crypto.KSet(5, 0x59f111f1)
        Crypto.KSet(6, 0x923f82a4)
        Crypto.KSet(7, 0xab1c5ed5)
        Crypto.KSet(8, 0xd807aa98)
        Crypto.KSet(9, 0x12835b01)
        Crypto.KSet(10, 0x243185be)
        Crypto.KSet(11, 0x550c7dc3)
        Crypto.KSet(12, 0x72be5d74)
        Crypto.KSet(13, 0x80deb1fe)
        Crypto.KSet(14, 0x9bdc06a7)
        Crypto.KSet(15, 0xc19bf174)
        Crypto.KSet(16, 0xe49b69c1)
        Crypto.KSet(17, 0xefbe4786)
        Crypto.KSet(18, 0x0fc19dc6)
        Crypto.KSet(19, 0x240ca1cc)
        Crypto.KSet(20, 0x2de92c6f)
        Crypto.KSet(21, 0x4a7484aa)
        Crypto.KSet(22, 0x5cb0a9dc)
        Crypto.KSet(23, 0x76f988da)
        Crypto.KSet(24, 0x983e5152)
        Crypto.KSet(25, 0xa831c66d)
        Crypto.KSet(26, 0xb00327c8)
        Crypto.KSet(27, 0xbf597fc7)
        Crypto.KSet(28, 0xc6e00bf3)
        Crypto.KSet(29, 0xd5a79147)
        Crypto.KSet(30, 0x06ca6351)
        Crypto.KSet(31, 0x14292967)
        Crypto.KSet(32, 0x27b70a85)
        Crypto.KSet(33, 0x2e1b2138)
        Crypto.KSet(34, 0x4d2c6dfc)
        Crypto.KSet(35, 0x53380d13)
        Crypto.KSet(36, 0x650a7354)
        Crypto.KSet(37, 0x766a0abb)
        Crypto.KSet(38, 0x81c2c92e)
        Crypto.KSet(39, 0x92722c85)
        Crypto.KSet(40, 0xa2bfe8a1)
        Crypto.KSet(41, 0xa81a664b)
        Crypto.KSet(42, 0xc24b8b70)
        Crypto.KSet(43, 0xc76c51a3)
        Crypto.KSet(44, 0xd192e819)
        Crypto.KSet(45, 0xd6990624)
