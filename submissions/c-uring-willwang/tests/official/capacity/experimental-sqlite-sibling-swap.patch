+SQLITE_PRIVATE void sqlite3PCacheSetDefault(void){
+  sqlite3_config(SQLITE_CONFIG_PCACHE2, pcache1DefaultMethods());
+}
+
+/* A B-tree sibling swap renumbers two existing dirty pages through a temporary
+** key. The BtShared mutex excludes other users of this pager during all three
+** moves. A shared cache group can evict pages, but cannot add keys to this
+** cache. After the last move the old upper bound is therefore valid again.
+** Keep external page cache methods completely outside this optimization. */
+static PCache1 *pcache1BeginSiblingSwap(PgHdr *pPg, Pgno temp, Pgno *pOldMax){
+  PCache1 *pCache;
+  if( memcmp(&sqlite3GlobalConfig.pcache2, pcache1DefaultMethods(),
+             sizeof(sqlite3_pcache_methods2))!=0 ) return 0;
+  pCache = (PCache1*)pPg->pCache->pCache;
+  pcache1EnterMutex(pCache->pGroup);
+  *pOldMax = pCache->iMaxKey;
+  pcache1LeaveMutex(pCache->pGroup);
+  return *pOldMax<temp ? pCache : 0;
+}
+static void pcache1EndSiblingSwap(PCache1 *pCache, Pgno temp, Pgno oldMax){
+  pcache1EnterMutex(pCache->pGroup);
+  if( pCache->iMaxKey==temp ) pCache->iMaxKey = oldMax;
+  pcache1LeaveMutex(pCache->pGroup);
 }

