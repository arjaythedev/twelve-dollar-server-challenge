cabal-version: 2.4
name:          server
version:       0.1.0.0
license:       MIT

executable server
  main-is:          Main.hs
  default-language: Haskell2010
  ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N -A4m -qg -I0 -kc4k"
  build-depends:    base >=4.17 && <5
                  , bytestring
                  , text
                  , stm
                  , warp ==3.4.16
                  , network ==3.2.9.0
                  , recv ==0.1.2
                  , streaming-commons ==0.2.3.1
                  , wai ==3.2.5
                  , http-types ==0.12.6
                  , direct-sqlite ==2.3.29
                  , base64-bytestring ==1.2.1.0
                  , cryptohash-sha256 ==0.11.102.1
