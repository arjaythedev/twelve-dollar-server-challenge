+            self.assertEqual(run.manifest["status"], "running")
+
+    def test_terminal_statuses_preserve_optional_payload_and_primary_error(self) -> None:
+        cases: tuple[tuple[TerminalStatus, int, str | None], ...] = (
+            ("passed", 0, None),
