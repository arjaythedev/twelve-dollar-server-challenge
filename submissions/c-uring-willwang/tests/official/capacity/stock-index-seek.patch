+/* Every physical likes-index key has the post id followed by its unique
+ * rowid. The maximum decoded cell belongs to this very snapshot. A full-key
+ * seek leaves SQLite responsible for all cursor state, including its stack. */
+static int after_likes_leaf(BtCursor *cursor) {
+    MemPage *page = cursor->pPage;
+    CellInfo cell;
+    RecordView record;
+    i64 post_id, rowid;
+    parse_cell(page, page->nCell - 1, &cell);
+    if (!record_view(&cell, &record) || !next_integer(&record, &post_id) ||
+        !next_integer(&record, &rowid) || record.types != record.end_types ||
+        record.values != record.end) return READ_FALLBACK;
+    Mem fields[2] = {{.flags = MEM_Int, .u.i = post_id}, {.flags = MEM_Int, .u.i = rowid}};
+    UnpackedRecord key = {.pKeyInfo = reader.likes.key, .aMem = fields, .nField = 2};
+    int cmp;
+    int rc = sqlite3BtreeIndexMoveto(cursor, &key, &cmp);
+    if (rc != SQLITE_OK) return rc;
+    if (cmp || sqlite3BtreeEof(cursor)) return READ_FALLBACK;
+    return sqlite3BtreeNext(cursor, 0);
 }
 
