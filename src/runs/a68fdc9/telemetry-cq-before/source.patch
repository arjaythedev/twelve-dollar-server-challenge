+        except (OSError, ValueError, KeyError) as error:
+            errors.append(f"Workload summary: {error}")
+    artifacts = (
+        ("perf-analysis.json", "profile"),
+        ("window.json", "window"),
+        ("telemetry.jsonl", "server_telemetry"),
+        ("collection-errors.json", "collection_errors"),
+    )
