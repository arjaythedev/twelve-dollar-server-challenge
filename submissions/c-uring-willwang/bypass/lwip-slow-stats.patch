+static struct tcp_slow_work_stats tcp_calendar_stats;
+
+static uint64_t
+tcp_calendar_now(clockid_t clock)
+{
+  struct timespec sample;
+  if (clock_gettime(clock, &sample) != 0) return 0;
+  return (uint64_t)sample.tv_sec * UINT64_C(1000000000) + (uint64_t)sample.tv_nsec;
+}
+
+static void
+tcp_calendar_duration(uint64_t start, uint64_t finish, uint64_t *sum, uint64_t *maximum)
+{
+  if (start && finish >= start) {
+    const uint64_t elapsed = finish - start;
+    *sum += elapsed;
+    if (elapsed > *maximum) *maximum = elapsed;
+  }
+}
+
+void
+tcp_slow_work_snapshot(struct tcp_slow_work_stats *out)
+{
+  if (out) *out = tcp_calendar_stats;
+}
