// Library.HTTP1.ailang — keep-alive HTTP/1.1 server on io_uring
//
// Single-threaded. Handler is AddressOf(fn) taking the connection pointer.
// Path and method are NUL-terminated in the request buffer after parse.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering.
// Released under the MIT License, as required for submissions to this challenge.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.IoUring

FixedPool.HTTP1Off {
    "FD": Initialize=0
    "STATE": Initialize=8
    "BUF": Initialize=16
    "CAP": Initialize=24
    "FILL": Initialize=32
    "METHOD": Initialize=40
    "PATH": Initialize=48
    "PATH_LEN": Initialize=56
    "CLEN": Initialize=64
    "BODY": Initialize=72
    "BODY_LEN": Initialize=80
    "BEARER": Initialize=88
    "BEARER_LEN": Initialize=96
    "KEEP": Initialize=104
    "OUT": Initialize=112
    "OUT_LEN": Initialize=120
    "OUT_SENT": Initialize=128
    "HDR_END": Initialize=136
    "DEFER": Initialize=144
    "PRIV_IN": Initialize=152
    "PRIV_OUT": Initialize=160
    "GEN": Initialize=168
    "VFRONT": Initialize=176
    "VIDX": Initialize=184
    "VGEN": Initialize=192
    "WSEQ": Initialize=200
    "RXARM": Initialize=208
    "TXBUSY": Initialize=216
    "EOF": Initialize=224
    "SLOT": Initialize=256
}

FixedPool.HTTP1St {
    "listen": Initialize=0, CanChange=True
    "epfd": Initialize=0, CanChange=True
    "slots": Initialize=0, CanChange=True
    "nslot": Initialize=64, CanChange=True
    "handler": Initialize=0, CanChange=True
    "cur": Initialize=0, CanChange=True
    "evbuf": Initialize=0, CanChange=True
    "evmax": Initialize=64, CanChange=True
    "bufsz": Initialize=8192, CanChange=True
    "hint": Initialize=0, CanChange=True
    "isget": Initialize=0, CanChange=True
    "outp": Initialize=0, CanChange=True
    "ol": Initialize=0, CanChange=True
    "defer_list": Initialize=0, CanChange=True
    "defer_n": Initialize=0, CanChange=True
    "defer_cap": Initialize=512, CanChange=True
    "commit_fn": Initialize=0, CanChange=True
    "commit_seq": Initialize=0, CanChange=True
    "done_ptr": Initialize=0, CanChange=True
    "wait_fn": Initialize=0, CanChange=True
    "pend": Initialize=0, CanChange=True
    "pend_cap": Initialize=65536, CanChange=True
    "pend_head": Initialize=0, CanChange=True
    "pend_tail": Initialize=0, CanChange=True
    "ticket": Initialize=0, CanChange=True
    "scratch_in": Initialize=0, CanChange=True
    "scratch_out": Initialize=0, CanChange=True
    "pool": Initialize=0, CanChange=True
    "reuseport": Initialize=0, CanChange=True
    "ring_fn": Initialize=0, CanChange=True
    "vsend_fn": Initialize=0, CanChange=True
    "tick_fn": Initialize=0, CanChange=True
    "pending": Initialize=0, CanChange=True
    "watch_fds": Initialize=0, CanChange=True
    "watch_n": Initialize=0, CanChange=True
    "efd_buf": Initialize=0, CanChange=True
    "pbuf_ring": Initialize=0, CanChange=True
    "pbuf_base": Initialize=0, CanChange=True
    "pbuf_n": Initialize=4096, CanChange=True
    "pbuf_sz": Initialize=2048, CanChange=True
    "starve_h": Initialize=0, CanChange=True
    "stats": Initialize=0, CanChange=True
    "st_t": Initialize=0, CanChange=True
    "st_pass": Initialize=0, CanChange=True
    "st_cqe": Initialize=0, CanChange=True
    "st_maxcq": Initialize=0, CanChange=True
    "st_nobuf": Initialize=0, CanChange=True
    // HTTP_STATS: wall-clock ms at the last pass, a 16-byte timespec, and the
    // gap that gets a "gap" line (HTTP_GAP_MS, default 200)
    "st_last": Initialize=0, CanChange=True
    "st_ts": Initialize=0, CanChange=True
    "st_gap": Initialize=200, CanChange=True
    "starve": Initialize=0, CanChange=True
    "starve_n": Initialize=0, CanChange=True
    "direct": Initialize=0, CanChange=True
    "rings": Initialize=0, CanChange=True
    "nring": Initialize=0, CanChange=True
    "maxring": Initialize=8, CanChange=True
    "ring_cur": Initialize=-1, CanChange=True
    "acc_ring": Initialize=0, CanChange=True
    "margin": Initialize=1024, CanChange=True
    "waitarg": Initialize=0, CanChange=True
    "sflags": Initialize=0, CanChange=True
    "rxmulti": Initialize=0, CanChange=True
}

// One record per io_uring instance: the IoUring state block, then its own
// provided-buffer ring and live connection count
FixedPool.HTTP1Rg {
    "PBUF_RING": Initialize=128
    "PBUF_BASE": Initialize=136
    "LIVE": Initialize=144
    "SIZE": Initialize=256
}

FixedPool.HTTP1C {
    "ENOBUFS": Initialize=-105
    "BGID": Initialize=0
}

FixedPool.HTTP1Ring {
    "TAG": Initialize=2147483392
    "MAX": Initialize=64
}

// io_uring operation types encoded in user_data bits 32+
FixedPool.HTTP1Op {
    "ACCEPT": Initialize=0
    "RECV": Initialize=1
    "SEND": Initialize=2
    "CLOSE": Initialize=3
    "POLL": Initialize=4
}


// ---- user_data encoding: data(24) | gen(8) | op(8) ----
Function.HTTP1.EncodeUD {
    Input: op: Integer
    Input: data: Integer
    Input: gen: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseOr(BitwiseOr(data, LeftShift(BitwiseAnd(gen, 255), 24)), LeftShift(op, 32)))
    }
}
Function.HTTP1.DecodeOp {
    Input: ud: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(RightShift(ud, 32), 255)) }
}
Function.HTTP1.DecodeData {
    Input: ud: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(ud, 16777215)) }
}
Function.HTTP1.DecodeGen {
    Input: ud: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(RightShift(ud, 24), 255)) }
}

Function.HTTP1.ConnIdx {
    Input: conn: Address
    Output: Integer
    Body: { ReturnValue(Divide(Subtract(conn, HTTP1St.slots), HTTP1Off.SLOT)) }
}


// ---- Buffer pool ----
Function.HTTP1.PoolGet {
    Output: Address
    Body: {
        b = HTTP1St.pool
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(Allocate(HTTP1St.bufsz)) }
        HTTP1St.pool = RDMEM_64(b)
        ReturnValue(b)
    }
}

Function.HTTP1.PoolPut {
    Input: b: Address
    Body: {
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        WRMEM_64(b, HTTP1St.pool)
        HTTP1St.pool = b
    }
}

Function.HTTP1.ReleaseIn {
    Input: conn: Address
    Body: {
        HTTP1.PoolPut(HTTP1.CGet(conn, HTTP1Off.PRIV_IN))
        HTTP1.CSet(conn, HTTP1Off.PRIV_IN, 0)
        HTTP1.CSet(conn, HTTP1Off.BUF, HTTP1St.scratch_in)
    }
}

Function.HTTP1.ReleaseOut {
    Input: conn: Address
    Body: {
        HTTP1.PoolPut(HTTP1.CGet(conn, HTTP1Off.PRIV_OUT))
        HTTP1.CSet(conn, HTTP1Off.PRIV_OUT, 0)
        HTTP1.CSet(conn, HTTP1Off.OUT, HTTP1St.scratch_out)
    }
}


// ---- Connection slots ----
Function.HTTP1.ConnAt {
    Input: i: Integer
    Output: Address
    Body: { ReturnValue(Add(HTTP1St.slots, Multiply(i, HTTP1Off.SLOT))) }
}

Function.HTTP1.CGet {
    Input: conn: Address
    Input: off: Integer
    Output: Integer
    Body: { ReturnValue(RDMEM_64(Add(conn, off))) }
}

Function.HTTP1.CSet {
    Input: conn: Address
    Input: off: Integer
    Input: val: Integer
    Body: { WRMEM_64(Add(conn, off), val) }
}

Function.HTTP1.ClearConn {
    Input: conn: Address
    Body: {
        HTTP1.CSet(conn, HTTP1Off.STATE, 0)
        HTTP1.CSet(conn, HTTP1Off.FILL, 0)
        HTTP1.CSet(conn, HTTP1Off.METHOD, 0)
        HTTP1.CSet(conn, HTTP1Off.PATH, 0)
        HTTP1.CSet(conn, HTTP1Off.PATH_LEN, 0)
        HTTP1.CSet(conn, HTTP1Off.CLEN, 0)
        HTTP1.CSet(conn, HTTP1Off.BODY, 0)
        HTTP1.CSet(conn, HTTP1Off.BODY_LEN, 0)
        HTTP1.CSet(conn, HTTP1Off.BEARER, 0)
        HTTP1.CSet(conn, HTTP1Off.BEARER_LEN, 0)
        HTTP1.CSet(conn, HTTP1Off.KEEP, 1)
        HTTP1.CSet(conn, HTTP1Off.OUT_LEN, 0)
        HTTP1.CSet(conn, HTTP1Off.OUT_SENT, 0)
        HTTP1.CSet(conn, HTTP1Off.HDR_END, 0)
        HTTP1.CSet(conn, HTTP1Off.DEFER, 0)
        HTTP1.CSet(conn, HTTP1Off.WSEQ, 0)
        fd = HTTP1.CGet(conn, HTTP1Off.FD)
        IfCondition GreaterThan(fd, 0) ThenBlock: {
            IfCondition EqualTo(HTTP1St.direct, 1) ThenBlock: {
                r = HTTP1.RingOf(HTTP1.ConnIdx(conn))
                HTTP1.UseRing(r)
                IoUring.PrepShutdownClose(Subtract(fd, 1), HTTP1.EncodeUD(HTTP1Op.CLOSE, 0, 0))
                rec = HTTP1.RingRec(r)
                WRMEM_64(Add(rec, HTTP1Rg.LIVE), Subtract(RDMEM_64(Add(rec, HTTP1Rg.LIVE)), 1))
            } ElseBlock: {
                Socket.Close(fd)
            }
        }
        HTTP1.CSet(conn, HTTP1Off.FD, -1)
        HTTP1.ReleaseIn(conn)
        // The kernel may still be reading an in-flight send's buffer; OnSend frees it
        IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.TXBUSY), 0) ThenBlock: { HTTP1.ReleaseOut(conn) }
    }
}

Function.HTTP1.ResetParse {
    Input: conn: Address
    Body: {
        HTTP1.CSet(conn, HTTP1Off.KEEP, 1)
        HTTP1.CSet(conn, HTTP1Off.OUT_LEN, 0)
        HTTP1.CSet(conn, HTTP1Off.OUT_SENT, 0)
        HTTP1.CSet(conn, HTTP1Off.HDR_END, 0)
        HTTP1.CSet(conn, HTTP1Off.CLEN, 0)
        HTTP1.CSet(conn, HTTP1Off.BEARER, 0)
        HTTP1.CSet(conn, HTTP1Off.DEFER, 0)
        HTTP1.CSet(conn, HTTP1Off.STATE, 1)
    }
}


// ---- Rings ----
Function.HTTP1.RingRec {
    Input: r: Integer
    Output: Address
    Body: { ReturnValue(Add(HTTP1St.rings, Multiply(r, HTTP1Rg.SIZE))) }
}

Function.HTTP1.UseRing {
    Input: r: Integer
    Body: {
        IfCondition EqualTo(r, HTTP1St.ring_cur) ThenBlock: { ReturnValue(0) }
        rec = HTTP1.RingRec(r)
        IoUring.Load(rec)
        HTTP1St.pbuf_ring = RDMEM_64(Add(rec, HTTP1Rg.PBUF_RING))
        HTTP1St.pbuf_base = RDMEM_64(Add(rec, HTTP1Rg.PBUF_BASE))
        HTTP1St.ring_cur = r
    }
}

Function.HTTP1.RingOf {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(Divide(idx, HTTP1St.nslot)) }
}

// The descriptor to put in an SQE: a direct descriptor's slot, or the fd
Function.HTTP1.IoFd {
    Input: conn: Address
    Output: Integer
    Body: {
        fd = HTTP1.CGet(conn, HTTP1Off.FD)
        IfCondition EqualTo(HTTP1St.direct, 1) ThenBlock: { ReturnValue(Subtract(fd, 1)) }
        ReturnValue(fd)
    }
}

// New ring with its buffer ring, a file table in direct mode, and its slots
// initialised. Returns its index, or -1. Leaves it current.
Function.HTTP1.AddRing {
    Output: Integer
    Body: {
        r = HTTP1St.nring
        IfCondition GreaterEqual(r, HTTP1St.maxring) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(IoUring.Setup(4096), 0) ThenBlock: { ReturnValue(-1) }
        rec = HTTP1.RingRec(r)
        IoUring.Save(rec)
        HTTP1St.ring_cur = r
        np = HTTP1St.pbuf_n
        pr = SystemCall(9, 0, Multiply(np, PBufOff.SIZE), 3, 34, -1, 0)
        pb = SystemCall(9, 0, Multiply(np, HTTP1St.pbuf_sz), 3, 34, -1, 0)
        IfCondition Or(LessThan(pr, 4096), LessThan(pb, 4096)) ThenBlock: { ReturnValue(-1) }
        WRMEM_64(Add(rec, HTTP1Rg.PBUF_RING), pr)
        WRMEM_64(Add(rec, HTTP1Rg.PBUF_BASE), pb)
        WRMEM_64(Add(rec, HTTP1Rg.LIVE), 0)
        HTTP1St.pbuf_ring = pr
        HTTP1St.pbuf_base = pb
        IfCondition LessThan(IoUring.RegisterPbufRing(pr, np, HTTP1C.BGID), 0) ThenBlock: {
            PrintMessage("io_uring provided buffer ring needs Linux 5.19+\n")
            ReturnValue(-1)
        }
        b = 0
        WhileLoop LessThan(b, np) {
            HTTP1.PbufPut(b)
            b = Add(b, 1)
        }
        IfCondition EqualTo(HTTP1St.direct, 1) ThenBlock: {
            IfCondition LessThan(IoUring.RegisterFilesSparse(HTTP1St.nslot), 0) ThenBlock: {
                PrintMessage("io_uring file table failed (needs Linux 5.19+ and RLIMIT_NOFILE >= HTTP_NSLOT)\n")
                ReturnValue(-1)
            }
        }
        i = Multiply(r, HTTP1St.nslot)
        end = Add(i, HTTP1St.nslot)
        WhileLoop LessThan(i, end) {
            conn = HTTP1.ConnAt(i)
            HTTP1.CSet(conn, HTTP1Off.FD, -1)
            HTTP1.CSet(conn, HTTP1Off.STATE, 0)
            HTTP1.CSet(conn, HTTP1Off.BUF, HTTP1St.scratch_in)
            HTTP1.CSet(conn, HTTP1Off.CAP, HTTP1St.bufsz)
            HTTP1.CSet(conn, HTTP1Off.OUT, HTTP1St.scratch_out)
            i = Add(i, 1)
        }
        HTTP1St.nring = Add(r, 1)
        ReturnValue(r)
    }
}

Function.HTTP1.ArmAccept {
    Input: r: Integer
    Body: {
        HTTP1.UseRing(r)
        ud = HTTP1.EncodeUD(HTTP1Op.ACCEPT, r, 0)
        IfCondition EqualTo(HTTP1St.direct, 1) ThenBlock: {
            IoUring.PrepAcceptDirect(HTTP1St.listen, ud, 1)
        } ElseBlock: {
            IoUring.PrepAcceptMulti(HTTP1St.listen, ud)
        }
    }
}

// The accepting ring is close to a full file table: an accept that finds no free
// slot has already dequeued the connection, so move before that can happen
Function.HTTP1.MoveAccept {
    Body: {
        from = HTTP1St.acc_ring
        lim = Subtract(HTTP1St.nslot, Multiply(HTTP1St.margin, 2))
        to = -1
        r = 0
        WhileLoop LessThan(r, HTTP1St.nring) {
            IfCondition NotEqual(r, from) ThenBlock: {
                IfCondition LessThan(RDMEM_64(Add(HTTP1.RingRec(r), HTTP1Rg.LIVE)), lim) ThenBlock: {
                    IfCondition EqualTo(to, -1) ThenBlock: { to = r }
                }
            }
            r = Add(r, 1)
        }
        IfCondition EqualTo(to, -1) ThenBlock: { to = HTTP1.AddRing() }
        IfCondition EqualTo(to, -1) ThenBlock: { ReturnValue(0) }
        HTTP1.UseRing(from)
        IoUring.PrepCancel(HTTP1.EncodeUD(HTTP1Op.ACCEPT, from, 0), HTTP1.EncodeUD(HTTP1Op.CLOSE, 0, 0))
        HTTP1St.acc_ring = to
        HTTP1.ArmAccept(to)
        HTTP1.UseRing(from)
    }
}


// ---- Setup: socket + io_uring + multishot accept ----
Function.HTTP1.Listen {
    Input: host: Address
    Input: port: Integer
    Output: Integer
    Body: {
        fd = Socket.Create(2, 1)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        Socket.SetReuseAddr(fd)
        IfCondition EqualTo(HTTP1St.reuseport, 1) ThenBlock: {
            Socket.SetSockInt(fd, SockOpt.SOL_SOCKET, 15)
        }
        // Accepted sockets inherit these; direct descriptors have no fd to set them on
        Socket.SetTcpNoDelay(fd)
        Socket.SetKeepAlive(fd)
        bn = Socket.BindInet(fd, host, port)
        IfCondition LessThan(bn, 0) ThenBlock: { Socket.Close(fd) ReturnValue(-1) }
        ln = Socket.Listen(fd, 16384)
        IfCondition LessThan(ln, 0) ThenBlock: { Socket.Close(fd) ReturnValue(-1) }
        HTTP1St.listen = fd

        IfCondition EqualTo(HTTP1St.direct, 1) ThenBlock: { HTTP1St.sflags = IoUringSqe.FIXED_FILE }
        IfCondition EqualTo(HTTP1St.direct, 0) ThenBlock: { HTTP1St.maxring = 1 }
        nslot = HTTP1St.nslot
        HTTP1St.scratch_in = Allocate(HTTP1St.bufsz)
        HTTP1St.scratch_out = Allocate(HTTP1St.bufsz)
        HTTP1St.rings = Allocate(Multiply(HTTP1St.maxring, HTTP1Rg.SIZE))
        total = Multiply(nslot, HTTP1St.maxring)
        HTTP1St.slots = SystemCall(9, 0, Multiply(total, HTTP1Off.SLOT), 3, 34, -1, 0)
        HTTP1St.starve = SystemCall(9, 0, Multiply(total, 32), 3, 34, -1, 0)
        HTTP1St.starve_n = 0
        HTTP1St.waitarg = Allocate(48)
        HTTP1St.defer_list = Allocate(4096)
        HTTP1St.defer_n = 0
        HTTP1St.defer_cap = 512
        HTTP1St.watch_fds = Allocate(1024)
        HTTP1St.watch_n = 0
        HTTP1St.efd_buf = Allocate(8)

        r = HTTP1.AddRing()
        IfCondition LessThan(r, 0) ThenBlock: {
            PrintMessage("io_uring setup failed\n")
            Socket.Close(fd)
            ReturnValue(-1)
        }
        HTTP1St.epfd = IoUring.ring_fd
        HTTP1St.acc_ring = 0
        HTTP1.ArmAccept(0)
        ReturnValue(fd)
    }
}

// Watch an external fd (eventfd) for readability via io_uring POLL_ADD multishot
Function.HTTP1.WatchFd {
    Input: fd: Integer
    Input: tag: Integer
    Body: {
        HTTP1.UseRing(0)
        i = HTTP1St.watch_n
        WRMEM_64(Add(HTTP1St.watch_fds, Multiply(i, 16)), fd)
        WRMEM_64(Add(HTTP1St.watch_fds, Add(Multiply(i, 16), 8)), tag)
        HTTP1St.watch_n = Add(i, 1)
        sqe = IoUring.GetSqe()
        IoUring.SqeSetOp(sqe, IoUringOp.POLL_ADD, fd)
        IoUring.SqeSetLen(sqe, 1)
        IoUring.SqeSetRwFlags(sqe, 1)
        IoUring.SqeSetUserData(sqe, HTTP1.EncodeUD(HTTP1Op.POLL, i, 0))
        IoUring.SubmitAdvance()
    }
}


Function.HTTP1.FindFree {
    Output: Integer
    Body: {
        nslot = HTTP1St.nslot
        i = HTTP1St.hint
        n = 0
        WhileLoop LessThan(n, nslot) {
            IfCondition GreaterEqual(i, nslot) ThenBlock: { i = 0 }
            conn = HTTP1.ConnAt(i)
            st = HTTP1.CGet(conn, HTTP1Off.STATE)
            IfCondition EqualTo(st, 0) ThenBlock: {
                HTTP1St.hint = Add(i, 1)
                ReturnValue(i)
            }
            i = Add(i, 1)
            n = Add(n, 1)
        }
        ReturnValue(-1)
    }
}


// ---- Queue helpers ----

Function.HTTP1.PbufPut {
    Input: bid: Integer
    Body: {
        addr = Add(HTTP1St.pbuf_base, Multiply(bid, HTTP1St.pbuf_sz))
        IoUring.PBufRingAdd(HTTP1St.pbuf_ring, addr, HTTP1St.pbuf_sz, bid, Subtract(HTTP1St.pbuf_n, 1))
    }
}

// With no partial request the recv takes a pooled buffer; a partial request
// already owns a private buffer, so the rest is read straight into it
Function.HTTP1.QueueRecv {
    Input: idx: Integer
    Body: {
        HTTP1.UseRing(HTTP1.RingOf(idx))
        conn = HTTP1.ConnAt(idx)
        IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.EOF), 1) ThenBlock: {
            HTTP1.ClearConn(conn)
            ReturnValue(0)
        }
        fd = HTTP1.IoFd(conn)
        fill = HTTP1.CGet(conn, HTTP1Off.FILL)
        gen = BitwiseAnd(HTTP1.CGet(conn, HTTP1Off.GEN), 255)
        ud = HTTP1.EncodeUD(HTTP1Op.RECV, Add(idx, 1), gen)
        IfCondition EqualTo(HTTP1St.rxmulti, 1) ThenBlock: {
            IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.RXARM), 0) ThenBlock: {
                HTTP1.CSet(conn, HTTP1Off.RXARM, 1)
                IoUring.PrepRecvMulti(fd, HTTP1C.BGID, ud, HTTP1St.sflags)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(fill, 0) ThenBlock: {
            HTTP1.ReleaseIn(conn)
            IoUring.PrepRecvBuf(fd, HTTP1St.pbuf_sz, HTTP1C.BGID, ud, HTTP1St.sflags)
        } ElseBlock: {
            buf = HTTP1.CGet(conn, HTTP1Off.BUF)
            IfCondition EqualTo(buf, HTTP1St.scratch_in) ThenBlock: {
                buf = HTTP1.PoolGet()
                MemoryCopy(buf, HTTP1St.scratch_in, fill)
                HTTP1.CSet(conn, HTTP1Off.BUF, buf)
                HTTP1.CSet(conn, HTTP1Off.PRIV_IN, buf)
            }
            cap = HTTP1.CGet(conn, HTTP1Off.CAP)
            IoUring.PrepRecv(fd, Add(buf, fill), Subtract(cap, fill), ud, HTTP1St.sflags)
        }
    }
}

Function.HTTP1.QueueSend {
    Input: idx: Integer
    Body: {
        HTTP1.UseRing(HTTP1.RingOf(idx))
        conn = HTTP1.ConnAt(idx)
        out = HTTP1.CGet(conn, HTTP1Off.OUT)
        sent = HTTP1.CGet(conn, HTTP1Off.OUT_SENT)
        left = Subtract(HTTP1.CGet(conn, HTTP1Off.OUT_LEN), sent)
        gen = BitwiseAnd(HTTP1.CGet(conn, HTTP1Off.GEN), 255)
        ud = HTTP1.EncodeUD(HTTP1Op.SEND, Add(idx, 1), gen)
        HTTP1.CSet(conn, HTTP1Off.TXBUSY, 1)
        IoUring.PrepSend(HTTP1.IoFd(conn), Add(out, sent), left, ud, HTTP1St.sflags)
    }
}


// ---- HTTP parsing (unchanged) ----

Function.HTTP1.LowerEq {
    Input: p: Address
    Input: n: Integer
    Input: want: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(p, i)
            IfCondition GreaterEqual(c, 65) ThenBlock: {
                IfCondition LessEqual(c, 90) ThenBlock: { c = Add(c, 32) }
            }
            w = RDMEM_8(want, i)
            IfCondition EqualTo(w, 0) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(c, w) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        wend = RDMEM_8(want, n)
        IfCondition NotEqual(wend, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.HTTP1.FindCRLFCRLF {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(-1) }
        i = 0
        lim = Subtract(n, 3)
        WhileLoop LessThan(i, lim) {
            IfCondition EqualTo(RDMEM_8(buf, i), 13) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(buf, Add(i, 1)), 10) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(buf, Add(i, 2)), 13) ThenBlock: {
                        IfCondition EqualTo(RDMEM_8(buf, Add(i, 3)), 10) ThenBlock: {
                            ReturnValue(i)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.HTTP1.ParseInt {
    Input: p: Address
    Input: n: Integer
    Output: Integer
    Body: {
        v = 0
        i = 0
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(p, i)
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: { ReturnValue(v) }
            v = Add(Multiply(v, 10), Subtract(c, 48))
            i = Add(i, 1)
        }
        ReturnValue(v)
    }
}

Function.HTTP1.Parse {
    Input: conn: Address
    Output: Integer
    Body: {
        buf = HTTP1.CGet(conn, HTTP1Off.BUF)
        fill = HTTP1.CGet(conn, HTTP1Off.FILL)
        hdr = HTTP1.FindCRLFCRLF(buf, fill)
        IfCondition LessThan(hdr, 0) ThenBlock: { ReturnValue(0) }
        HTTP1.CSet(conn, HTTP1Off.HDR_END, hdr)
        sp1 = -1
        sp2 = -1
        i = 0
        cr = 0
        WhileLoop LessThan(i, hdr) {
            b = RDMEM_8(buf, i)
            IfCondition EqualTo(b, 32) ThenBlock: {
                IfCondition EqualTo(sp1, -1) ThenBlock: { sp1 = i } ElseBlock: {
                    IfCondition EqualTo(sp2, -1) ThenBlock: { sp2 = i }
                }
            }
            IfCondition EqualTo(b, 10) ThenBlock: { cr = Add(i, 1) BreakLoop }
            i = Add(i, 1)
        }
        IfCondition LessThan(sp1, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(sp2, Add(sp1, 2)) ThenBlock: { ReturnValue(-1) }
        HTTP1.CSet(conn, HTTP1Off.CLEN, 0)
        HTTP1.CSet(conn, HTTP1Off.BEARER, 0)
        HTTP1.CSet(conn, HTTP1Off.KEEP, 1)
        HTTP1St.isget = 0
        IfCondition EqualTo(sp1, 3) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(buf, 0), 71) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(buf, 1), 69) ThenBlock: {
                    IfCondition EqualTo(RDMEM_8(buf, 2), 84) ThenBlock: { HTTP1St.isget = 1 }
                }
            }
        }
        WhileLoop LessThan(cr, hdr) {
            nl = cr
            WhileLoop LessThan(nl, hdr) {
                IfCondition EqualTo(RDMEM_8(buf, nl), 10) ThenBlock: { BreakLoop }
                nl = Add(nl, 1)
            }
            hlen = Subtract(nl, cr)
            IfCondition GreaterThan(hlen, 0) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(buf, Subtract(nl, 1)), 13) ThenBlock: { hlen = Subtract(hlen, 1) }
            }
            colon = -1
            hi = 0
            WhileLoop LessThan(hi, hlen) {
                IfCondition EqualTo(RDMEM_8(buf, Add(cr, hi)), 58) ThenBlock: { colon = hi BreakLoop }
                hi = Add(hi, 1)
            }
            IfCondition GreaterThan(colon, 0) ThenBlock: {
                name_p = Add(buf, cr)
                c0 = RDMEM_8(buf, cr)
                IfCondition EqualTo(c0, 67) ThenBlock: { c0 = 99 }
                IfCondition EqualTo(c0, 65) ThenBlock: { c0 = 97 }
                need = 0
                IfCondition EqualTo(c0, 99) ThenBlock: { need = 1 }
                IfCondition EqualTo(c0, 97) ThenBlock: {
                    IfCondition EqualTo(HTTP1St.isget, 0) ThenBlock: { need = 1 }
                }
                IfCondition EqualTo(need, 1) ThenBlock: {
                    vs = Add(colon, 1)
                    WhileLoop LessThan(vs, hlen) {
                        vc = RDMEM_8(buf, Add(cr, vs))
                        IfCondition EqualTo(vc, 32) ThenBlock: { vs = Add(vs, 1) } ElseBlock: {
                            IfCondition EqualTo(vc, 9) ThenBlock: { vs = Add(vs, 1) } ElseBlock: { BreakLoop }
                        }
                    }
                    vlen = Subtract(hlen, vs)
                    IfCondition EqualTo(c0, 99) ThenBlock: {
                        IfCondition EqualTo(HTTP1St.isget, 0) ThenBlock: {
                            is_cl = HTTP1.LowerEq(name_p, colon, "content-length")
                            IfCondition EqualTo(is_cl, 1) ThenBlock: {
                                cl = HTTP1.ParseInt(Add(buf, Add(cr, vs)), vlen)
                                HTTP1.CSet(conn, HTTP1Off.CLEN, cl)
                            }
                        }
                        is_co = HTTP1.LowerEq(name_p, colon, "connection")
                        IfCondition EqualTo(is_co, 1) ThenBlock: {
                            is_close = HTTP1.LowerEq(Add(buf, Add(cr, vs)), vlen, "close")
                            IfCondition EqualTo(is_close, 1) ThenBlock: { HTTP1.CSet(conn, HTTP1Off.KEEP, 0) }
                        }
                    }
                    IfCondition EqualTo(c0, 97) ThenBlock: {
                        is_au = HTTP1.LowerEq(name_p, colon, "authorization")
                        IfCondition EqualTo(is_au, 1) ThenBlock: {
                            HTTP1.CSet(conn, HTTP1Off.BEARER, Add(buf, Add(cr, vs)))
                            HTTP1.CSet(conn, HTTP1Off.BEARER_LEN, vlen)
                            WRMEM_8(buf, Add(cr, hlen), 0)
                        }
                    }
                }
            }
            cr = Add(nl, 1)
        }
        clen = HTTP1.CGet(conn, HTTP1Off.CLEN)
        need = Add(Add(hdr, 4), clen)
        IfCondition LessThan(fill, need) ThenBlock: { ReturnValue(0) }
        WRMEM_8(buf, sp1, 0)
        WRMEM_8(buf, sp2, 0)
        HTTP1.CSet(conn, HTTP1Off.METHOD, buf)
        path = Add(buf, Add(sp1, 1))
        HTTP1.CSet(conn, HTTP1Off.PATH, path)
        HTTP1.CSet(conn, HTTP1Off.PATH_LEN, Subtract(sp2, Add(sp1, 1)))
        HTTP1.CSet(conn, HTTP1Off.BODY, Add(buf, Add(hdr, 4)))
        HTTP1.CSet(conn, HTTP1Off.BODY_LEN, clen)
        ReturnValue(1)
    }
}

Function.HTTP1.Consume {
    Input: conn: Address
    Body: {
        buf = HTTP1.CGet(conn, HTTP1Off.BUF)
        fill = HTTP1.CGet(conn, HTTP1Off.FILL)
        hdr = HTTP1.CGet(conn, HTTP1Off.HDR_END)
        clen = HTTP1.CGet(conn, HTTP1Off.CLEN)
        used = Add(Add(hdr, 4), clen)
        IfCondition GreaterThan(fill, used) ThenBlock: {
            left = Subtract(fill, used)
            MemoryCopy(buf, Add(buf, used), left)
            HTTP1.CSet(conn, HTTP1Off.FILL, left)
        } ElseBlock: {
            HTTP1.CSet(conn, HTTP1Off.FILL, 0)
        }
    }
}


// ---- Response building (unchanged) ----

Function.HTTP1.Append {
    Input: conn: Address
    Input: src: Address
    Input: n: Integer
    Body: {
        out = HTTP1.CGet(conn, HTTP1Off.OUT)
        ol = HTTP1.CGet(conn, HTTP1Off.OUT_LEN)
        cap = HTTP1St.bufsz
        IfCondition GreaterThan(Add(ol, n), cap) ThenBlock: { n = Subtract(cap, ol) }
        IfCondition GreaterThan(n, 0) ThenBlock: {
            MemoryCopy(Add(out, ol), src, n)
            HTTP1.CSet(conn, HTTP1Off.OUT_LEN, Add(ol, n))
        }
    }
}

Function.HTTP1.AppendZ {
    Input: conn: Address
    Input: s: Address
    Body: { n = StringLength(s) HTTP1.Append(conn, s, n) }
}

Function.HTTP1.AppendInt {
    Input: conn: Address
    Input: v: Integer
    Body: {
        out = HTTP1.CGet(conn, HTTP1Off.OUT)
        ol = HTTP1.CGet(conn, HTTP1Off.OUT_LEN)
        cap = HTTP1St.bufsz
        IfCondition EqualTo(v, 0) ThenBlock: {
            IfCondition LessThan(ol, cap) ThenBlock: {
                WRMEM_8(out, ol, 48)
                HTTP1.CSet(conn, HTTP1Off.OUT_LEN, Add(ol, 1))
            }
            ReturnValue(0)
        }
        x = v
        IfCondition LessThan(x, 0) ThenBlock: {
            IfCondition LessThan(ol, cap) ThenBlock: { WRMEM_8(out, ol, 45) ol = Add(ol, 1) }
            x = Subtract(0, x)
        }
        n = 0
        t = x
        WhileLoop GreaterThan(t, 0) { n = Add(n, 1) t = Divide(t, 10) }
        IfCondition GreaterThan(Add(ol, n), cap) ThenBlock: { n = Subtract(cap, ol) }
        IfCondition LessEqual(n, 0) ThenBlock: { HTTP1.CSet(conn, HTTP1Off.OUT_LEN, ol) ReturnValue(0) }
        i = Subtract(n, 1)
        WhileLoop GreaterEqual(i, 0) {
            d = Modulo(x, 10)
            WRMEM_8(out, Add(ol, i), Add(48, d))
            x = Divide(x, 10)
            i = Subtract(i, 1)
        }
        HTTP1.CSet(conn, HTTP1Off.OUT_LEN, Add(ol, n))
    }
}

Function.HTTP1.Reply {
    Input: conn: Address
    Input: status: Integer
    Input: body: Address
    Input: body_len: Integer
    Body: {
        HTTP1St.cur = conn
        st = status
        bl = body_len
        bp = body
        keep = HTTP1.CGet(HTTP1St.cur, HTTP1Off.KEEP)
        HTTP1St.outp = HTTP1.CGet(HTTP1St.cur, HTTP1Off.OUT)
        cap = HTTP1St.bufsz
        MemoryCopy(HTTP1St.outp, "HTTP/1.1 ", 9)
        HTTP1St.ol = 9
        h = Divide(st, 100)
        tens = Divide(st, 10)
        t = Subtract(tens, Multiply(h, 10))
        o = Subtract(st, Multiply(tens, 10))
        WRMEM_8(HTTP1St.outp, HTTP1St.ol, Add(48, h))
        WRMEM_8(HTTP1St.outp, Add(HTTP1St.ol, 1), Add(48, t))
        WRMEM_8(HTTP1St.outp, Add(HTTP1St.ol, 2), Add(48, o))
        HTTP1St.ol = Add(HTTP1St.ol, 3)
        IfCondition EqualTo(st, 200) ThenBlock: { MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), " OK\r\n", 5) HTTP1St.ol = Add(HTTP1St.ol, 5) }
        IfCondition EqualTo(st, 201) ThenBlock: { MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), " Created\r\n", 10) HTTP1St.ol = Add(HTTP1St.ol, 10) }
        IfCondition EqualTo(st, 400) ThenBlock: { MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), " Bad Request\r\n", 14) HTTP1St.ol = Add(HTTP1St.ol, 14) }
        IfCondition EqualTo(st, 401) ThenBlock: { MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), " Unauthorized\r\n", 15) HTTP1St.ol = Add(HTTP1St.ol, 15) }
        IfCondition EqualTo(st, 404) ThenBlock: { MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), " Not Found\r\n", 12) HTTP1St.ol = Add(HTTP1St.ol, 12) }
        IfCondition EqualTo(st, 500) ThenBlock: { MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), " Internal Server Error\r\n", 24) HTTP1St.ol = Add(HTTP1St.ol, 24) }
        IfCondition EqualTo(st, 503) ThenBlock: { MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), " Service Unavailable\r\n", 22) HTTP1St.ol = Add(HTTP1St.ol, 22) }
        MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), "Content-Type: application/json\r\nContent-Length: ", 48)
        HTTP1St.ol = Add(HTTP1St.ol, 48)
        IfCondition EqualTo(bl, 0) ThenBlock: { WRMEM_8(HTTP1St.outp, HTTP1St.ol, 48) HTTP1St.ol = Add(HTTP1St.ol, 1) }
        IfCondition GreaterThan(bl, 0) ThenBlock: {
            x = bl
            n = 0
            t2 = x
            WhileLoop GreaterThan(t2, 0) { n = Add(n, 1) t2 = Divide(t2, 10) }
            ol = HTTP1St.ol
            IfCondition GreaterThan(Add(ol, n), cap) ThenBlock: { n = Subtract(cap, ol) }
            IfCondition GreaterThan(n, 0) ThenBlock: {
                i = Subtract(n, 1)
                WhileLoop GreaterEqual(i, 0) {
                    d = Modulo(x, 10)
                    WRMEM_8(HTTP1St.outp, Add(HTTP1St.ol, i), Add(48, d))
                    x = Divide(x, 10)
                    i = Subtract(i, 1)
                }
                HTTP1St.ol = Add(HTTP1St.ol, n)
            }
        }
        IfCondition EqualTo(keep, 1) ThenBlock: {
            MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), "\r\nConnection: keep-alive\r\n\r\n", 28)
            HTTP1St.ol = Add(HTTP1St.ol, 28)
        }
        IfCondition NotEqual(keep, 1) ThenBlock: {
            MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), "\r\nConnection: close\r\n\r\n", 23)
            HTTP1St.ol = Add(HTTP1St.ol, 23)
        }
        IfCondition GreaterThan(bl, 0) ThenBlock: {
            ol2 = HTTP1St.ol
            room = Subtract(cap, ol2)
            IfCondition GreaterThan(bl, room) ThenBlock: { bl = room }
            IfCondition GreaterThan(bl, 0) ThenBlock: {
                MemoryCopy(Add(HTTP1St.outp, HTTP1St.ol), bp, bl)
                HTTP1St.ol = Add(HTTP1St.ol, bl)
            }
        }
        HTTP1.CSet(HTTP1St.cur, HTTP1Off.OUT_LEN, HTTP1St.ol)
        HTTP1.CSet(HTTP1St.cur, HTTP1Off.OUT_SENT, 0)
        HTTP1.CSet(HTTP1St.cur, HTTP1Off.STATE, 3)
    }
}

// Synchronous send attempt. Returns 1=done, 0=would-block, -1=error.
Function.HTTP1.Flush {
    Input: conn: Address
    Output: Integer
    Body: {
        fd = HTTP1.CGet(conn, HTTP1Off.FD)
        IfCondition EqualTo(fd, -2) ThenBlock: {
            ReturnValue(CallIndirect(HTTP1St.vsend_fn, conn))
        }
        out = HTTP1.CGet(conn, HTTP1Off.OUT)
        ol = HTTP1.CGet(conn, HTTP1Off.OUT_LEN)
        sent = HTTP1.CGet(conn, HTTP1Off.OUT_SENT)
        left = Subtract(ol, sent)
        IfCondition LessEqual(left, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(HTTP1St.direct, 1) ThenBlock: { ReturnValue(0) }
        n = Socket.SendNB(fd, Add(out, sent), left)
        IfCondition EqualTo(n, Subtract(0, 11)) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(-1) }
        sent = Add(sent, n)
        HTTP1.CSet(conn, HTTP1Off.OUT_SENT, sent)
        IfCondition GreaterEqual(sent, ol) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.HTTP1.Method {
    Input: conn: Address
    Output: Address
    Body: { ReturnValue(HTTP1.CGet(conn, HTTP1Off.METHOD)) }
}
Function.HTTP1.Path {
    Input: conn: Address
    Output: Address
    Body: { ReturnValue(HTTP1.CGet(conn, HTTP1Off.PATH)) }
}
Function.HTTP1.Bearer {
    Input: conn: Address
    Output: Address
    Body: { ReturnValue(HTTP1.CGet(conn, HTTP1Off.BEARER)) }
}
Function.HTTP1.Body {
    Input: conn: Address
    Output: Address
    Body: { ReturnValue(HTTP1.CGet(conn, HTTP1Off.BODY)) }
}
Function.HTTP1.BodyLen {
    Input: conn: Address
    Output: Integer
    Body: { ReturnValue(HTTP1.CGet(conn, HTTP1Off.BODY_LEN)) }
}


// ---- Deferred commit + pending queue (unchanged logic, FlushOne queues send on partial) ----

Function.HTTP1.FlushOne {
    Input: conn: Address
    Body: {
        HTTP1.CSet(conn, HTTP1Off.DEFER, 0)
        HTTP1.CSet(conn, HTTP1Off.WSEQ, 0)
        fd = HTTP1.CGet(conn, HTTP1Off.FD)
        live = 0
        IfCondition GreaterThan(fd, 0) ThenBlock: { live = 1 }
        IfCondition EqualTo(fd, -2) ThenBlock: { live = 1 }
        IfCondition EqualTo(live, 1) ThenBlock: {
            fr = HTTP1.Flush(conn)
            IfCondition EqualTo(fr, -1) ThenBlock: { HTTP1.ClearConn(conn) }
            IfCondition EqualTo(fr, 1) ThenBlock: {
                keep = HTTP1.CGet(conn, HTTP1Off.KEEP)
                IfCondition EqualTo(keep, 0) ThenBlock: {
                    HTTP1.ClearConn(conn)
                } ElseBlock: {
                    HTTP1.ResetParse(conn)
                    HTTP1.ReleaseOut(conn)
                    // A virtual connection (fd -2) lives outside the slot table and has no socket
                    IfCondition GreaterThan(fd, 0) ThenBlock: {
                        HTTP1.QueueRecv(HTTP1.ConnIdx(conn))
                    }
                }
            }
            IfCondition EqualTo(fr, 0) ThenBlock: {
                // Partial send — queue remaining bytes via io_uring
                idx = HTTP1.ConnIdx(conn)
                HTTP1.QueueSend(idx)
            }
        }
    }
}

Function.HTTP1.FlushDeferred {
    Body: {
        n = HTTP1St.defer_n
        i = 0
        WhileLoop LessThan(i, n) {
            conn = RDMEM_64(Add(HTTP1St.defer_list, Multiply(i, 8)))
            HTTP1.FlushOne(conn)
            i = Add(i, 1)
        }
        HTTP1St.defer_n = 0
    }
}

Function.HTTP1.FlushPending {
    Body: {
        IfCondition EqualTo(HTTP1St.done_ptr, 0) ThenBlock: { ReturnValue(0) }
        done = RDMEM_64(HTTP1St.done_ptr)
        mask = Subtract(HTTP1St.pend_cap, 1)
        WhileLoop LessThan(HTTP1St.pend_tail, HTTP1St.pend_head) {
            e = Add(HTTP1St.pend, Multiply(BitwiseAnd(HTTP1St.pend_tail, mask), 24))
            IfCondition GreaterThan(RDMEM_64(Add(e, 16)), done) ThenBlock: { ReturnValue(0) }
            conn = RDMEM_64(e)
            IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.WSEQ), RDMEM_64(Add(e, 8))) ThenBlock: {
                IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.DEFER), 1) ThenBlock: { HTTP1.FlushOne(conn) }
            }
            HTTP1St.pend_tail = Add(HTTP1St.pend_tail, 1)
        }
    }
}

Function.HTTP1.AfterCommit {
    Body: {
        IfCondition EqualTo(HTTP1St.done_ptr, 0) ThenBlock: {
            HTTP1.FlushDeferred()
            ReturnValue(0)
        }
        seq = HTTP1St.commit_seq
        IfCondition GreaterEqual(RDMEM_64(HTTP1St.done_ptr), seq) ThenBlock: {
            HTTP1.FlushPending()
            HTTP1.FlushDeferred()
            ReturnValue(0)
        }
        IfCondition EqualTo(HTTP1St.pend, 0) ThenBlock: {
            HTTP1St.pend = Allocate(Multiply(HTTP1St.pend_cap, 24))
        }
        mask = Subtract(HTTP1St.pend_cap, 1)
        n = HTTP1St.defer_n
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition GreaterEqual(Subtract(HTTP1St.pend_head, HTTP1St.pend_tail), HTTP1St.pend_cap) ThenBlock: {
                CallIndirect(HTTP1St.wait_fn, RDMEM_64(Add(Add(HTTP1St.pend, Multiply(BitwiseAnd(HTTP1St.pend_tail, mask), 24)), 16)))
                HTTP1.FlushPending()
            }
            conn = RDMEM_64(Add(HTTP1St.defer_list, Multiply(i, 8)))
            HTTP1St.ticket = Add(HTTP1St.ticket, 1)
            HTTP1.CSet(conn, HTTP1Off.WSEQ, HTTP1St.ticket)
            e = Add(HTTP1St.pend, Multiply(BitwiseAnd(HTTP1St.pend_head, mask), 24))
            WRMEM_64(e, conn)
            WRMEM_64(Add(e, 8), HTTP1St.ticket)
            WRMEM_64(Add(e, 16), seq)
            HTTP1St.pend_head = Add(HTTP1St.pend_head, 1)
            i = Add(i, 1)
        }
        HTTP1St.defer_n = 0
    }
}

Function.HTTP1.Defer {
    Input: conn: Address
    Body: {
        IfCondition GreaterEqual(HTTP1St.defer_n, HTTP1St.defer_cap) ThenBlock: {
            fn = HTTP1St.commit_fn
            IfCondition NotEqual(fn, 0) ThenBlock: { CallIndirect(fn, conn) }
            HTTP1.AfterCommit()
        }
        HTTP1.CSet(conn, HTTP1Off.WSEQ, 0)
        i = HTTP1St.defer_n
        WRMEM_64(Add(HTTP1St.defer_list, Multiply(i, 8)), conn)
        HTTP1St.defer_n = Add(i, 1)
        HTTP1.CSet(conn, HTTP1Off.DEFER, 1)
    }
}

Function.HTTP1.HandleReady {
    Input: conn: Address
    Body: {
        HTTP1.CSet(conn, HTTP1Off.OUT, HTTP1St.scratch_out)
        HTTP1St.cur = conn
        h = HTTP1St.handler
        CallIndirect(h, conn)
        HTTP1.Consume(conn)
    }
}

Function.HTTP1.Unshare {
    Input: conn: Address
    Body: {
        fill = HTTP1.CGet(conn, HTTP1Off.FILL)
        IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.BUF), HTTP1St.scratch_in) ThenBlock: {
            IfCondition GreaterThan(fill, 0) ThenBlock: {
                b = HTTP1.PoolGet()
                MemoryCopy(b, HTTP1St.scratch_in, fill)
                HTTP1.CSet(conn, HTTP1Off.BUF, b)
                HTTP1.CSet(conn, HTTP1Off.PRIV_IN, b)
            }
        } ElseBlock: {
            IfCondition EqualTo(fill, 0) ThenBlock: { HTTP1.ReleaseIn(conn) }
        }
        pending = 0
        IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.DEFER), 1) ThenBlock: { pending = 1 }
        IfCondition GreaterThan(HTTP1.CGet(conn, HTTP1Off.FD), 0) ThenBlock: {
            IfCondition LessThan(HTTP1.CGet(conn, HTTP1Off.OUT_SENT), HTTP1.CGet(conn, HTTP1Off.OUT_LEN)) ThenBlock: { pending = 1 }
        }
        IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.OUT), HTTP1St.scratch_out) ThenBlock: {
            IfCondition EqualTo(pending, 1) ThenBlock: {
                b = HTTP1.CGet(conn, HTTP1Off.PRIV_OUT)
                IfCondition EqualTo(b, 0) ThenBlock: { b = HTTP1.PoolGet() }
                ol = HTTP1.CGet(conn, HTTP1Off.OUT_LEN)
                IfCondition GreaterThan(ol, 0) ThenBlock: { MemoryCopy(b, HTTP1St.scratch_out, ol) }
                HTTP1.CSet(conn, HTTP1Off.OUT, b)
                HTTP1.CSet(conn, HTTP1Off.PRIV_OUT, b)
            }
        } ElseBlock: {
            IfCondition EqualTo(pending, 0) ThenBlock: { HTTP1.ReleaseOut(conn) }
        }
    }
}


// ============================================================
// CQE handlers
// ============================================================

Function.HTTP1.OnAccept {
    Input: r: Integer
    Input: res: Integer
    Input: flags: Integer
    Body: {
        more = BitwiseAnd(flags, IoUringCqe.F_MORE)
        IfCondition LessThan(res, 0) ThenBlock: {
            IfCondition EqualTo(more, 0) ThenBlock: {
                IfCondition EqualTo(r, HTTP1St.acc_ring) ThenBlock: { HTTP1.ArmAccept(r) }
            }
            ReturnValue(0)
        }
        idx = 0
        fdv = 0
        IfCondition EqualTo(HTTP1St.direct, 1) ThenBlock: {
            idx = Add(Multiply(r, HTTP1St.nslot), res)
            fdv = Add(res, 1)
            rec = HTTP1.RingRec(r)
            WRMEM_64(Add(rec, HTTP1Rg.LIVE), Add(RDMEM_64(Add(rec, HTTP1Rg.LIVE)), 1))
        } ElseBlock: {
            idx = HTTP1.FindFree()
            IfCondition LessThan(idx, 0) ThenBlock: {
                Socket.Close(res)
                ReturnValue(0)
            }
            fdv = res
        }
        conn = HTTP1.ConnAt(idx)
        HTTP1.CSet(conn, HTTP1Off.FD, fdv)
        HTTP1.CSet(conn, HTTP1Off.GEN, Add(HTTP1.CGet(conn, HTTP1Off.GEN), 1))
        HTTP1.ResetParse(conn)
        HTTP1.CSet(conn, HTTP1Off.FILL, 0)
        HTTP1.CSet(conn, HTTP1Off.RXARM, 0)
        HTTP1.CSet(conn, HTTP1Off.EOF, 0)
        IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.TXBUSY), 1) ThenBlock: {
            HTTP1.CSet(conn, HTTP1Off.PRIV_OUT, 0)
            HTTP1.CSet(conn, HTTP1Off.OUT, HTTP1St.scratch_out)
            HTTP1.CSet(conn, HTTP1Off.TXBUSY, 0)
        }
        HTTP1.CSet(conn, HTTP1Off.CAP, HTTP1St.bufsz)
        HTTP1.QueueRecv(idx)
        IfCondition EqualTo(r, HTTP1St.acc_ring) ThenBlock: {
            IfCondition EqualTo(HTTP1St.direct, 1) ThenBlock: {
                live = RDMEM_64(Add(HTTP1.RingRec(r), HTTP1Rg.LIVE))
                IfCondition GreaterEqual(live, Subtract(HTTP1St.nslot, HTTP1St.margin)) ThenBlock: {
                    HTTP1.MoveAccept()
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(more, 0) ThenBlock: { HTTP1.ArmAccept(r) }
        }
    }
}

Function.HTTP1.OnRecv {
    Input: data: Integer
    Input: gen: Integer
    Input: res: Integer
    Input: flags: Integer
    Body: {
        idx = Subtract(data, 1)
        conn = HTTP1.ConnAt(idx)
        // A pooled buffer goes back to the ring on every path, stale CQEs included
        bid = -1
        IfCondition NotEqual(BitwiseAnd(flags, IoUringCqe.F_BUFFER), 0) ThenBlock: {
            bid = RightShift(flags, 16)
        }
        live = 1
        IfCondition NotEqual(BitwiseAnd(HTTP1.CGet(conn, HTTP1Off.GEN), 255), gen) ThenBlock: { live = 0 }
        IfCondition LessThan(HTTP1.CGet(conn, HTTP1Off.FD), 0) ThenBlock: { live = 0 }
        IfCondition EqualTo(live, 0) ThenBlock: {
            IfCondition GreaterEqual(bid, 0) ThenBlock: { HTTP1.PbufPut(bid) }
            ReturnValue(0)
        }
        IfCondition EqualTo(BitwiseAnd(flags, IoUringCqe.F_MORE), 0) ThenBlock: { HTTP1.CSet(conn, HTTP1Off.RXARM, 0) }
        IfCondition EqualTo(res, HTTP1C.ENOBUFS) ThenBlock: {
            HTTP1St.st_nobuf = Add(HTTP1St.st_nobuf, 1)
            e = Add(HTTP1St.starve, Multiply(HTTP1St.starve_n, 16))
            WRMEM_64(e, idx)
            WRMEM_64(Add(e, 8), gen)
            HTTP1St.starve_n = Add(HTTP1St.starve_n, 1)
            ReturnValue(0)
        }
        IfCondition LessEqual(res, 0) ThenBlock: {
            IfCondition GreaterEqual(bid, 0) ThenBlock: { HTTP1.PbufPut(bid) }
            // End of input with requests still buffered or answering: finish them, then close
            IfCondition EqualTo(res, 0) ThenBlock: {
                pend = HTTP1.CGet(conn, HTTP1Off.FILL)
                IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.DEFER), 1) ThenBlock: { pend = 1 }
                IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.TXBUSY), 1) ThenBlock: { pend = 1 }
                IfCondition GreaterThan(pend, 0) ThenBlock: {
                    HTTP1.CSet(conn, HTTP1Off.EOF, 1)
                    ReturnValue(0)
                }
            }
            HTTP1.ClearConn(conn)
            ReturnValue(0)
        }
        fill = HTTP1.CGet(conn, HTTP1Off.FILL)
        // With a multishot receive, data can arrive while a response is still pending;
        // it waits in a private buffer and is parsed once that response is out
        busy = 0
        IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.DEFER), 1) ThenBlock: { busy = 1 }
        IfCondition LessThan(HTTP1.CGet(conn, HTTP1Off.OUT_SENT), HTTP1.CGet(conn, HTTP1Off.OUT_LEN)) ThenBlock: { busy = 1 }
        IfCondition EqualTo(busy, 1) ThenBlock: {
            IfCondition EqualTo(HTTP1.CGet(conn, HTTP1Off.BUF), HTTP1St.scratch_in) ThenBlock: {
                pb = HTTP1.PoolGet()
                IfCondition GreaterThan(fill, 0) ThenBlock: { MemoryCopy(pb, HTTP1St.scratch_in, fill) }
                HTTP1.CSet(conn, HTTP1Off.BUF, pb)
                HTTP1.CSet(conn, HTTP1Off.PRIV_IN, pb)
            }
        }
        IfCondition GreaterEqual(bid, 0) ThenBlock: {
            IfCondition GreaterThan(res, Subtract(HTTP1.CGet(conn, HTTP1Off.CAP), fill)) ThenBlock: {
                HTTP1.PbufPut(bid)
                HTTP1.ClearConn(conn)
                ReturnValue(0)
            }
            MemoryCopy(Add(HTTP1.CGet(conn, HTTP1Off.BUF), fill), Add(HTTP1St.pbuf_base, Multiply(bid, HTTP1St.pbuf_sz)), res)
            HTTP1.PbufPut(bid)
        }
        HTTP1.CSet(conn, HTTP1Off.FILL, Add(fill, res))
        IfCondition EqualTo(busy, 0) ThenBlock: { HTTP1.Pump(idx) }
    }
}

// Parse and handle buffered requests (pipelining loop)
Function.HTTP1.Pump {
    Input: idx: Integer
    Body: {
        conn = HTTP1.ConnAt(idx)
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            pr = HTTP1.Parse(conn)
            IfCondition EqualTo(pr, 0) ThenBlock: {
                // Need more data; a partial request must leave the shared buffer first
                HTTP1.Unshare(conn)
                HTTP1.QueueRecv(idx)
                looping = 0
            } ElseBlock: {
                IfCondition EqualTo(pr, -1) ThenBlock: {
                    HTTP1.ClearConn(conn)
                    looping = 0
                } ElseBlock: {
                    HTTP1.HandleReady(conn)
                    df = HTTP1.CGet(conn, HTTP1Off.DEFER)
                    IfCondition EqualTo(df, 1) ThenBlock: {
                        HTTP1.Unshare(conn)
                        looping = 0
                    } ElseBlock: {
                        // Try synchronous send first (most responses fit in one write)
                        HTTP1.Unshare(conn)
                        fr = HTTP1.Flush(conn)
                        IfCondition EqualTo(fr, 0) ThenBlock: { fr = HTTP1.Flush(conn) }
                        IfCondition EqualTo(fr, -1) ThenBlock: {
                            HTTP1.ClearConn(conn)
                            looping = 0
                        } ElseBlock: {
                            IfCondition EqualTo(fr, 1) ThenBlock: {
                                // Fully sent
                                keep = HTTP1.CGet(conn, HTTP1Off.KEEP)
                                IfCondition EqualTo(keep, 0) ThenBlock: {
                                    HTTP1.ClearConn(conn)
                                    looping = 0
                                } ElseBlock: {
                                    HTTP1.ResetParse(conn)
                                    HTTP1.ReleaseOut(conn)
                                    fill2 = HTTP1.CGet(conn, HTTP1Off.FILL)
                                    IfCondition EqualTo(fill2, 0) ThenBlock: {
                                        // No more buffered data, queue recv
                                        HTTP1.QueueRecv(idx)
                                        looping = 0
                                    }
                                    // else: more data in buffer, continue pipelining loop
                                }
                            } ElseBlock: {
                                // Partial send — queue remaining via io_uring
                                HTTP1.QueueSend(idx)
                                looping = 0
                            }
                        }
                    }
                }
            }
        }
    }
}

Function.HTTP1.OnSend {
    Input: data: Integer
    Input: gen: Integer
    Input: res: Integer
    Body: {
        idx = Subtract(data, 1)
        conn = HTTP1.ConnAt(idx)
        cur_gen = BitwiseAnd(HTTP1.CGet(conn, HTTP1Off.GEN), 255)
        IfCondition NotEqual(cur_gen, gen) ThenBlock: { ReturnValue(0) }
        HTTP1.CSet(conn, HTTP1Off.TXBUSY, 0)
        fd = HTTP1.CGet(conn, HTTP1Off.FD)
        IfCondition LessThan(fd, 0) ThenBlock: {
            HTTP1.ReleaseOut(conn)
            ReturnValue(0)
        }

        IfCondition LessEqual(res, 0) ThenBlock: {
            HTTP1.ClearConn(conn)
            ReturnValue(0)
        }

        sent = HTTP1.CGet(conn, HTTP1Off.OUT_SENT)
        sent = Add(sent, res)
        HTTP1.CSet(conn, HTTP1Off.OUT_SENT, sent)
        ol = HTTP1.CGet(conn, HTTP1Off.OUT_LEN)

        IfCondition LessThan(sent, ol) ThenBlock: {
            // More to send
            HTTP1.QueueSend(idx)
            ReturnValue(0)
        }

        // Fully sent
        keep = HTTP1.CGet(conn, HTTP1Off.KEEP)
        IfCondition EqualTo(keep, 0) ThenBlock: {
            HTTP1.ClearConn(conn)
            ReturnValue(0)
        }

        HTTP1.ResetParse(conn)
        HTTP1.ReleaseOut(conn)

        // Check for pipelined data
        fill = HTTP1.CGet(conn, HTTP1Off.FILL)
        IfCondition GreaterThan(fill, 0) ThenBlock: {
            HTTP1.Pump(idx)
            ReturnValue(0)
        }

        HTTP1.QueueRecv(idx)
    }
}

Function.HTTP1.OnPoll {
    Input: data: Integer
    Input: flags: Integer
    Body: {
        i = data
        watch_fd = RDMEM_64(Add(HTTP1St.watch_fds, Multiply(i, 16)))
        watch_tag = RDMEM_64(Add(HTTP1St.watch_fds, Add(Multiply(i, 16), 8)))
        // Read the eventfd to consume the counter
        SystemCall(0, watch_fd, HTTP1St.efd_buf, 8)
        // Call the ring callback
        tag_val = Subtract(watch_tag, HTTP1Ring.TAG)
        CallIndirect(HTTP1St.ring_fn, tag_val)
        // If multishot cancelled, re-arm
        IfCondition EqualTo(BitwiseAnd(flags, IoUringCqe.F_MORE), 0) ThenBlock: {
            sqe = IoUring.GetSqe()
            IoUring.SqeSetOp(sqe, IoUringOp.POLL_ADD, watch_fd)
            IoUring.SqeSetLen(sqe, 1)
            IoUring.SqeSetRwFlags(sqe, 1)
            ud = HTTP1.EncodeUD(HTTP1Op.POLL, i, 0)
            IoUring.SqeSetUserData(sqe, ud)
            IoUring.SubmitAdvance()
        }
    }
}


// ============================================================
// Event loop
// ============================================================

Function.HTTP1.Drain {
    Input: r: Integer
    Body: {
        // Handlers may switch rings (a commit flushes sends on any ring), so select r each time
        WhileLoop 1 {
            HTTP1.UseRing(r)
            cqe = IoUring.PeekCqe()
            IfCondition EqualTo(cqe, 0) ThenBlock: { BreakLoop }
            HTTP1St.st_cqe = Add(HTTP1St.st_cqe, 1)
            cqe_res = IoUring.CqeRes(cqe)
            cqe_ud = IoUring.CqeUserData(cqe)
            cqe_flags = IoUring.CqeFlags(cqe)
            IoUring.CqAdvance()
            op = HTTP1.DecodeOp(cqe_ud)
            data = HTTP1.DecodeData(cqe_ud)
            gen = HTTP1.DecodeGen(cqe_ud)
            IfCondition EqualTo(op, HTTP1Op.RECV) ThenBlock: { HTTP1.OnRecv(data, gen, cqe_res, cqe_flags) }
            IfCondition EqualTo(op, HTTP1Op.SEND) ThenBlock: { HTTP1.OnSend(data, gen, cqe_res) }
            IfCondition EqualTo(op, HTTP1Op.ACCEPT) ThenBlock: { HTTP1.OnAccept(data, cqe_res, cqe_flags) }
            IfCondition EqualTo(op, HTTP1Op.POLL) ThenBlock: { HTTP1.OnPoll(data, cqe_flags) }
        }
    }
}

// HTTP_STATS=1: one line per 10 s with passes, completions, the largest ring-0
// batch, receives that found no buffer, and live connections per ring
Function.HTTP1.Stats {
    Input: cq0: Integer
    Body: {
        HTTP1St.st_pass = Add(HTTP1St.st_pass, 1)
        IfCondition GreaterThan(cq0, HTTP1St.st_maxcq) ThenBlock: { HTTP1St.st_maxcq = cq0 }
        IfCondition EqualTo(HTTP1St.st_ts, 0) ThenBlock: { HTTP1St.st_ts = Allocate(16) }
        SystemCall(228, 0, HTTP1St.st_ts)
        now = Add(Multiply(RDMEM_64(HTTP1St.st_ts), 1000), Divide(RDMEM_64(Add(HTTP1St.st_ts, 8)), 1000000))
        IfCondition NotEqual(HTTP1St.st_last, 0) ThenBlock: {
            IfCondition GreaterEqual(Subtract(now, HTTP1St.st_last), HTTP1St.st_gap) ThenBlock: {
                PrintMessage("gap ms=")
                PrintNumber(Subtract(now, HTTP1St.st_last))
                PrintMessage(" end=")
                PrintNumber(now)
                PrintMessage(" cq0=")
                PrintNumber(cq0)
                PrintMessage("\n")
            }
        }
        HTTP1St.st_last = now
        t = SystemCall(201, 0)
        IfCondition EqualTo(HTTP1St.st_t, 0) ThenBlock: { HTTP1St.st_t = t }
        IfCondition LessThan(t, Add(HTTP1St.st_t, 10)) ThenBlock: { ReturnValue(0) }
        HTTP1St.st_t = t
        PrintMessage("stat pass=")
        PrintNumber(HTTP1St.st_pass)
        PrintMessage(" cqe=")
        PrintNumber(HTTP1St.st_cqe)
        PrintMessage(" maxcq0=")
        PrintNumber(HTTP1St.st_maxcq)
        PrintMessage(" nobuf=")
        PrintNumber(HTTP1St.st_nobuf)
        PrintMessage(" live=")
        r = 0
        WhileLoop LessThan(r, HTTP1St.nring) {
            PrintNumber(RDMEM_64(Add(HTTP1.RingRec(r), HTTP1Rg.LIVE)))
            PrintMessage(",")
            r = Add(r, 1)
        }
        PrintMessage("\n")
        HTTP1St.st_pass = 0
        HTTP1St.st_cqe = 0
        HTTP1St.st_maxcq = 0
        HTTP1St.st_nobuf = 0
    }
}

// One pass: every other ring submits and reaps without waiting, then ring 0
// submits and waits (with a 1 ms cap when other rings exist, as nothing wakes it for them)
Function.HTTP1.Serve {
    Input: handler: Address
    Body: {
        HTTP1St.handler = handler
        WhileLoop 1 {
            r = 1
            WhileLoop LessThan(r, HTTP1St.nring) {
                HTTP1.UseRing(r)
                IoUring.Enter(IoUring.SqPending(), 0, IoUringEnter.GETEVENTS)
                HTTP1.Drain(r)
                r = Add(r, 1)
            }
            HTTP1.UseRing(0)
            c0 = HTTP1St.st_cqe
            busy = 0
            IfCondition GreaterThan(HTTP1St.starve_n, HTTP1St.starve_h) ThenBlock: { busy = 1 }
            IfCondition EqualTo(busy, 1) ThenBlock: {
                IoUring.Enter(IoUring.SqPending(), 0, IoUringEnter.GETEVENTS)
            } ElseBlock: {
                IfCondition GreaterThan(HTTP1St.nring, 1) ThenBlock: {
                    IoUring.EnterWait(IoUring.SqPending(), 1, 1000, HTTP1St.waitarg)
                } ElseBlock: {
                    IoUring.Enter(IoUring.SqPending(), 1, IoUringEnter.GETEVENTS)
                }
            }
            HTTP1.Drain(0)
            IfCondition EqualTo(HTTP1St.stats, 1) ThenBlock: { HTTP1.Stats(Subtract(HTTP1St.st_cqe, c0)) }

            // Receives that found their buffer ring empty, oldest first. Re-arming them all at
            // once would drain the ring again in the same pass, so at most half a ring's worth go
            // per pass; ring 0 doesn't wait while any are left.
            h = HTTP1St.starve_h
            stop = HTTP1St.starve_n
            budget = Divide(HTTP1St.pbuf_n, 2)
            IfCondition GreaterThan(Subtract(stop, h), budget) ThenBlock: { stop = Add(h, budget) }
            WhileLoop LessThan(h, stop) {
                e = Add(HTTP1St.starve, Multiply(h, 16))
                sidx = RDMEM_64(e)
                sconn = HTTP1.ConnAt(sidx)
                IfCondition EqualTo(BitwiseAnd(HTTP1.CGet(sconn, HTTP1Off.GEN), 255), RDMEM_64(Add(e, 8))) ThenBlock: {
                    IfCondition GreaterThan(HTTP1.CGet(sconn, HTTP1Off.FD), 0) ThenBlock: { HTTP1.QueueRecv(sidx) }
                }
                h = Add(h, 1)
            }
            HTTP1St.starve_h = h
            IfCondition EqualTo(h, HTTP1St.starve_n) ThenBlock: {
                HTTP1St.starve_h = 0
                HTTP1St.starve_n = 0
            } ElseBlock: {
                // Each connection is queued at most once, so the live part is never larger than
                // the table; slide it back to the front once the head has moved far enough
                IfCondition GreaterThan(h, Divide(Multiply(HTTP1St.nslot, HTTP1St.maxring), 2)) ThenBlock: {
                    n = Subtract(HTTP1St.starve_n, h)
                    MemoryCopy(HTTP1St.starve, Add(HTTP1St.starve, Multiply(h, 16)), Multiply(n, 16))
                    HTTP1St.starve_h = 0
                    HTTP1St.starve_n = n
                }
            }

            IfCondition GreaterThan(HTTP1St.defer_n, 0) ThenBlock: {
                fn = HTTP1St.commit_fn
                IfCondition NotEqual(fn, 0) ThenBlock: { CallIndirect(fn, HTTP1St.slots) }
                HTTP1.AfterCommit()
            }
            HTTP1.FlushPending()
            IfCondition NotEqual(HTTP1St.tick_fn, 0) ThenBlock: {
                CallIndirect(HTTP1St.tick_fn, 0)
            }
        }
    }
}
