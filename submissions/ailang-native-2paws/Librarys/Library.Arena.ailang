// Library.Arena.ailang
// Slab allocator for fixed-size allocations
// Eliminates per-allocation mmap overhead
//
// Design:
//   - mmap large chunks (4MB) once
//   - Divide into fixed-size blocks (24, 32, 64, 128 bytes)
//   - Free list per size class
//   - Allocate = pop from free list or bump pointer
//   - Deallocate = push to free list (instant reuse)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering.
// Released under the MIT License, as required for submissions to this challenge.

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.ArenaConst {
    "CHUNK_SIZE": Initialize=4194304   
    "SLAB_24": Initialize=24
    "SLAB_32": Initialize=32
    "SLAB_64": Initialize=64
    "SLAB_128": Initialize=128
    "SLAB_256": Initialize=256
}

// =============================================================================
// SLAB STATE - One per size class
// =============================================================================
FixedPool.Slab24 {
    "chunk": Initialize=0         
    "next": Initialize=0           
    "end": Initialize=0            
    "free_list": Initialize=0     
    "alloc_count": Initialize=0     
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

