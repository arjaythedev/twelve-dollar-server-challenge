#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;

if (!is_file(dirname(__DIR__).'/vendor/autoload.php')) {
    throw new LogicException('Run "composer install" first.');
}

if (isset($_SERVER['argv'][1]) && realpath($_SERVER['argv'][0]) !== __FILE__ && realpath($_SERVER['argv'][1]) === __FILE__) {
    $_SERVER['argv'] = array_slice($_SERVER['argv'], 1);
    $_SERVER['argc'] = count($_SERVER['argv']);
    $argv = $_SERVER['argv'];
    $argc = $_SERVER['argc'];
}

require dirname(__DIR__).'/vendor/autoload.php';

$kernel = new Kernel($_SERVER['APP_ENV'] ?? 'prod', (bool) ($_SERVER['APP_DEBUG'] ?? false));

exit((new Application($kernel))->run());
