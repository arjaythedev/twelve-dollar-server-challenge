// General arena for large/variable allocations. After the 8K..64K slabs
// were added this now only sees sizes > 65536 (handled by direct mmap)
// — the bump-allocator fields below are kept for back-compat but are
// effectively unused.
FixedPool.ArenaGeneral {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "alloc_count": Initialize=0
    "chunk_count": Initialize=0
    "fallback_count": Initialize=0
}

// Per-turn scratch bump. While on==1, Arena_Alloc takes from here and
// Arena_Free is a no-op. ScratchEnd rewinds to the first chunk (pages stay
// mapped — RSS is high-water of the biggest turn, not a leak).
FixedPool.ArenaScratch {
    "on":          Initialize=0, CanChange=True
    "head":        Initialize=0, CanChange=True
    "chunk":       Initialize=0, CanChange=True
    "next":        Initialize=0, CanChange=True
    "end":         Initialize=0, CanChange=True
    "chunk_count": Initialize=0, CanChange=True
}

// Large-mmap cache for allocations > 65536 bytes. Power-of-2 buckets
// indexed by log2(size) of the rounded-up allocation. Freeing pushes
// onto the bucket's freelist; allocating pops if non-empty, else mmaps.
// This fixes the "just leak" path that previously burned arbitrary RSS
// when large XArrays grew past 65536 and called Arena_Free on the
// old backing. Each freelist node stores next_ptr in the first 8 B
// and alloc_size in bytes 8..15, so the block itself serves as its
// own list header.
FixedPool.LargeMmapCache {
    "b_131072":  Initialize=0, CanChange=True
    "b_262144":  Initialize=0, CanChange=True
    "b_524288":  Initialize=0, CanChange=True
    "b_1048576": Initialize=0, CanChange=True
    "b_2097152": Initialize=0, CanChange=True
    "b_4194304": Initialize=0, CanChange=True
    "hits":      Initialize=0, CanChange=True
    "misses":    Initialize=0, CanChange=True
    "releases":  Initialize=0, CanChange=True
    "unmapped":  Initialize=0, CanChange=True
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Arena_Init {
    Body: {
        // Initialize 24-byte slab
        Arena_InitSlab24()
        
        // Initialize 32-byte slab
        Arena_InitSlab32()
        
        // Initialize 64-byte slab  
        Arena_InitSlab64()
        
        // Initialize 128-byte slab
        Arena_InitSlab128()
        
        // Initialize 256-byte slab
        Arena_InitSlab256()
        
        // Initialize 512-byte slab
        Arena_InitSlab512()
        
        // Initialize 1024-byte slab
        Arena_InitSlab1024()
        
        // Initialize 2048-byte slab
        Arena_InitSlab2048()
        
        // Initialize 4096-byte slab
        Arena_InitSlab4096()

        // Initialize 8192-byte slab
        Arena_InitSlab8192()

        // Initialize 16384-byte slab
        Arena_InitSlab16384()

        // Initialize 32768-byte slab
        Arena_InitSlab32768()

        // Initialize 65536-byte slab
        Arena_InitSlab65536()

        // Initialize general arena
        Arena_InitGeneral()

        ReturnValue(1)
    }
}

Function.Arena_InitSlab24 {
    Body: {
        chunk = Arena_MmapChunk()
        StoreValue(chunk, 0)
        Slab24.chunk = chunk
        Slab24.next = Add(chunk, 8)
        Slab24.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab24.free_list = 0
        Slab24.alloc_count = 0
        Slab24.free_count = 0
        Slab24.chunk_count = 1
    }
}

