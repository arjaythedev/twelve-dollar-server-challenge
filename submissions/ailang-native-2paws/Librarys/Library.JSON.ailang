// Library.JSON.ailang
// JSON Parse & Build Library for AILang - v2.2
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering.
// Released under the MIT License, as required for submissions to this challenge.
//
// v2.2 FIX:
//   - Removed ConcatFree function entirely. The self-hosting compiler
//     has codegen issues with a helper that calls StringConcat then
//     Deallocate on its own input parameter (register clobber between
//     the two built-in calls).
//   - All serialization now uses the proven v1 inline temp pattern:
//       temp = result
//       result = StringConcat(result, something)
//       Deallocate(temp, 0)
//   - All Deallocate calls use size 0 (allocator auto-detect)
//
// TAGGED VALUE LAYOUT (16 bytes):
//   [0-7]  type tag (JType constant)
//   [8-15] value (Address for strings/objects/arrays, Integer for numbers/bools)

LibraryImport.Arrays
LibraryImport.StringUtils

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.JType {
    "NULL": Initialize=0
    "STRING": Initialize=1
    "NUMBER": Initialize=2
    "BOOL": Initialize=3
    "OBJECT": Initialize=4
    "ARRAY": Initialize=5
}

FixedPool.JParse {
    "buffer": Initialize=0, CanChange=True
    "size": Initialize=0, CanChange=True
    "pos": Initialize=0, CanChange=True
    "error": Initialize=0, CanChange=True
    "error_msg": Initialize=0, CanChange=True
}

// =============================================================================
// TAGGED VALUE MANAGEMENT
// =============================================================================
Function.JSON.Tag {
    Input: vtype: Integer
    Input: value: Address
    Output: Address
    Body: {
        t = Allocate(16)
        StoreValue(t, vtype)
        StoreValue(Add(t, 8), value)
        ReturnValue(t)
    }
}

Function.JSON.TagType {
    Input: tagged: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(JType.NULL) }
        ReturnValue(Dereference(tagged))
    }
}

Function.JSON.TagValue {
    Input: tagged: Address
    Output: Address
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

// =============================================================================
// UNWRAP HELPERS
// =============================================================================
Function.JSON.AsObject {
    Input: tagged: Address
    Output: Address
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(tagged)
        IfCondition NotEqual(vtype, JType.OBJECT) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

Function.JSON.AsArray {
    Input: tagged: Address
    Output: Address
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(tagged)
        IfCondition NotEqual(vtype, JType.ARRAY) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

Function.JSON.AsString {
    Input: tagged: Address
    Output: Address
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(tagged)
        IfCondition NotEqual(vtype, JType.STRING) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

Function.JSON.AsNumber {
    Input: tagged: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(tagged)
        IfCondition NotEqual(vtype, JType.NUMBER) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

Function.JSON.AsBool {
    Input: tagged: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        vtype = Dereference(tagged)
        IfCondition NotEqual(vtype, JType.BOOL) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(tagged, 8)))
    }
}

Function.JSON.ArrayLength {
    Input: arr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Array.Size(arr))
    }
}

Function.JSON.ArrayGet {
    Input: arr: Address
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Array.Get(arr, index))
    }
}

// =============================================================================
// CONSTRUCTORS
// =============================================================================
Function.JSON.NewObject {
    Output: Address
    Body: {
        ReturnValue(SHash.Create(16))
    }
}

Function.JSON.NewArray {
    Output: Address
    Body: {
        ReturnValue(Array.Create(16))
    }
}

// =============================================================================
// OBJECT SETTERS - Store tagged values into XSHash
// =============================================================================
Function.JSON.SetString {
    Input: obj: Address
    Input: key: Address
    Input: value: Address
    Body: {
        tagged = JSON.Tag(JType.STRING, value)
        SHash.Insert(obj, key, tagged)
    }
}

Function.JSON.SetNumber {
    Input: obj: Address
    Input: key: Address
    Input: value: Integer
    Body: {
        tagged = JSON.Tag(JType.NUMBER, value)
        SHash.Insert(obj, key, tagged)
    }
}

Function.JSON.SetBool {
    Input: obj: Address
    Input: key: Address
    Input: value: Integer
    Body: {
        tagged = JSON.Tag(JType.BOOL, value)
        SHash.Insert(obj, key, tagged)
    }
}

Function.JSON.SetNull {
    Input: obj: Address
    Input: key: Address
    Body: {
        tagged = JSON.Tag(JType.NULL, 0)
        SHash.Insert(obj, key, tagged)
    }
}

Function.JSON.SetObject {
    Input: obj: Address
    Input: key: Address
    Input: child: Address
    Body: {
        tagged = JSON.Tag(JType.OBJECT, child)
        SHash.Insert(obj, key, tagged)
    }
}

Function.JSON.SetArray {
    Input: obj: Address
    Input: key: Address
    Input: child: Address
    Body: {
        tagged = JSON.Tag(JType.ARRAY, child)
        SHash.Insert(obj, key, tagged)
    }
}

