+#if LWIP_TCP_FAST_WORK
+/* The active list is ordered by registration / most recent promotion. A
+ * minimum rank therefore names a conservative prefix, in exact list order.
+ * Boundaries contain no weak pointers to PCBs that a callback may delete. */
+#define TCP_FAST_NONE UINT64_MAX
+static u64_t tcp_fast_rank;
+static u64_t tcp_fast_due = TCP_FAST_NONE;
+static u64_t tcp_fast_again = TCP_FAST_NONE;
+static u8_t tcp_fast_running;
+static u8_t tcp_last_full_timer;
+
+void
+tcp_fast_work_mark(struct tcp_pcb *pcb)
+{
+  const u64_t rank = pcb->fast_order;
+  if (rank != 0 && rank < tcp_fast_due) tcp_fast_due = rank;
+  if (tcp_fast_running && rank != 0 && rank < tcp_fast_again) tcp_fast_again = rank;
+}
+
+static void
+tcp_fast_promote(struct tcp_pcb *pcb)
+{
+  if (tcp_fast_rank == TCP_FAST_NONE - 1) {
+    /* Reserve zero for unregistered PCBs and all-ones for an empty pass.
+     * Renumber in place; a tick in progress remains conservative. */
+    struct tcp_pcb *p;
+    u64_t rank = TCP_FAST_NONE / 2;
+    tcp_fast_rank = rank;
+    for (p = tcp_active_pcbs; p != NULL; p = p->next) p->fast_order = rank--;
+    tcp_fast_due = 0;
+    if (tcp_fast_running) tcp_fast_again = 0;
+  }
+  pcb->fast_order = ++tcp_fast_rank;
+}
+#endif
